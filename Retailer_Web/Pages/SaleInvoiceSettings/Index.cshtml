@page "/Setting/Invoicesetting"
@model Retailer.Web.Pages.SaleInvoiceSettings.IndexModel
@{
    ViewData["Title"] = "Invoice Settings";
}

<h2>Invoice Settings</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<a asp-page="Create" class="btn btn-primary mb-2">Create New</a>

<table class="table table-bordered table-striped mt-2">
    <thead>
        <tr>
            <th>ID</th>
            <th>Company</th>
            <th>Branch</th>
            <th>Page Size</th>
            <th>Orientation</th>
            <th>Created At</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @if (Model.Settings != null && Model.Settings.Any())
    {
        @foreach (var s in Model.Settings)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.companyID</td>
                <td>@s.branchID</td>
                <td>@s.PageSize</td>
                <td>@s.Orientation</td>
                <td>@s.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-warning">Edit</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this setting?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="7" class="text-center">No invoice settings found.</td>
        </tr>
    }
    </tbody>
</table>

