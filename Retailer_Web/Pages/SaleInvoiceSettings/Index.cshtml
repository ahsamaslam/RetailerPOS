@page
@model Retailer.Web.Pages.SaleInvoiceSettings.IndexModel
@{
} 

<h2>Invoice Settings</h2>

<a asp-page="Create" class="btn btn-primary">Create New</a>

<table class="table table-bordered mt-2">
    <thead>
        <tr>
            <th>Company</th>
            <th>Branch</th>
            <th>Page Size</th>
            <th>Orientation</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var s in Model.Settings)
    {
        <tr>
            <td>@s.companyID</td>
            <td>@s.branchID</td>
            <td>@s.PageSize</td>
            <td>@s.Orientation</td>
            <td>
                <a asp-page="Edit" asp-route-id="@s.Id">Edit</a>
            </td>
        </tr>
    }
    </tbody>
</table>
