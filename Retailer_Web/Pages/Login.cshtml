@page
@model Retailer.Web.Pages.LoginModel
@{
    Layout = null;
}
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login/Signup Form</title>
<link href="@Url.Content("~/css/loginstyle.css")" rel="stylesheet" />

</head> 
<body>


     <div class="container">
        <div class="form-box login">
          <form method="post">
                <h1>Login</h1>
                <div class="input-box">
                    <input type="text" placeholder="Username"  asp-for="UserName"  required />
                    <i class="bx bxs-user"></i>
                </div>
                <div class="input-box">
                    <input type="password" asp-for="Password" placeholder="Password" required />
                    <i class="bx bxs-lock-alt"></i>
                </div>
                <div class="forgot-link">
                    <a href="#">Forgot Password?</a>
                </div>
                <button type="submit" class="btn">Login</button>

            </form>
        </div>
         <div class="toggle-box">
        <div class="toggle-panel toggle-left">
          <h1>Hello, Welcome!</h1> 
        </div>

        <div class="toggle-panel toggle-right">
          <h1>Welcome Back!</h1>
          <p>Already have an account?</p>
          <button class="btn login-btn">Login</button>
        </div>
      </div>
        </div>

    

      
       
</body>