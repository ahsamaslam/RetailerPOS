@page
@model Retailer.Web.Pages.Setting.UserProfileModel
@{
}

<main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
        <!--begin::Container-->
        <div class="container-fluid">
            <!--begin::Row-->
            <div class="row">
                <div class="col-sm-6"><h3 class="mb-0">User Profile</h3></div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
                    </ol>
                </div>
            </div>
            <!--end::Row-->
        </div>
        <!--end::Container-->
    </div>
    <div class="app-content">
 

       
                <div class="col-md-12">
                    <div class="row mb-2">
                        <div class="col-md-6">
                   <form method="post" enctype="multipart/form-data" asp-page-handler="UpdateProfile">
                <div class="col-md-12">
                    <input type="hidden" asp-for="Input.Id" />
                    <label>Name</label>
                    <input asp-for="Input.UserName"  readonly   class="form-control" />
                </div>
                <div class="col-md-12">
                    <label>Email</label>
                    <input asp-for="Input.Email" class="form-control" />
                </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <div class="row mb-2">
                                    <div class="col-md-12">
                                        <!-- Preview -->
                                        <div style="padding:10px; margin-top:10px;">
                                            <img id="logoPreview"
                                                 src="@(string.IsNullOrEmpty(Model.Input.picture) ? Url.Content("~/images/default-logo.png") : Model.Input.picture)"
                                                 alt="Feature Image" style="max-width:300px;  " />
                                        </div>
                                        <div class="col-md-12">
                                            <label asp-for="Input.picture" class="control-label">Feature Image</label>

                                            <!-- File upload input -->
                                            <input asp-for="LogoFile" type="file" class="form-control" accept="image/*" onchange="previewImage(event)" />
                                        </div>

                                    </div>
                                </div>
                                <span asp-validation-for="Input.picture" class="text-danger"></span>
                            </div>
                        </div>

                        @if (Model.IsAdmin)
                        {
                            <button type="submit" class="btn btn-success">Update</button>
                            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                        }
                    </form>
        
            </div>
                    <div class="col-md-6">
                          <!-- ================= Password Change Form ================= -->
        <form method="post" asp-page-handler="ChangePassword">

                        <div class="col-md-12">
                            <input type="hidden" asp-for="Input.Id" />
                            <label>Old Password</label>
                            <input asp-for="Input.oldPassword" type="password" class="form-control" />
                        </div>
                        <div class="col-md-12">
                            <label>Current Password</label>
                            <input asp-for="Input.currentPasswordA" type="password" class="form-control" />
                        </div>

                        <div class="col-md-12">
                            <label>Retype Current Password</label>
                            <input asp-for="Input.currentPasswordB" type="password" class="form-control" />
                        </div>
                        <button type="submit" class="btn btn-warning">Change Password</button>
                    </form>


                    </div>
            </div>
            </div>
           
    </div>
</main>
<script>
    function previewImage(event) {
        var input = event.target;
        var reader = new FileReader();
        reader.onload = function () {
            var dataURL = reader.result;
            var output = document.getElementById('logoPreview');
            output.src = dataURL;
            output.style.display = 'block';
        };
        reader.readAsDataURL(input.files[0]);
    }
</script>
