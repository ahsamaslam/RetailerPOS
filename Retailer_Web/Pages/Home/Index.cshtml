                    <!-- Placeholder Pie Chart -->
                    <canvas id="purchasePieChart" height="10"></canvas>
                </div>
                <table class="table table-sm table-bordered mt-2">
                    <tbody>
                        <tr>
                            <th>Total Sales</th>
