@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const salesCtx = document.getElementById('salesChart').getContext('2d');
        const salesChart = new Chart(salesCtx, {
          type: 'bar',
          data: {
            labels: ['Oct-20', 'Nov-20', 'Dec-20', 'Jan-21', 'Feb-21', 'Mar-21', 'Apr-21'],
            datasets: [{
              label: 'Sales Order',
              backgroundColor: 'rgba(54, 162, 235, 0.5)',
              borderColor: 'rgba(54, 162, 235, 1)',
              borderWidth: 1,
              data: [60, 55, 180, 70, 60, 55, 50]
            }, {
              label: 'Sales Amount',
              type: 'line',
              data: [1000, 1200, 1800, 900, 850, 700, 600],
              fill: false,
              borderColor: 'black',
              tension: 0.1
            }]
          },
          options: {
            responsive: true,
            scales: {
              y: { beginAtZero: true }
            }
          }
        });

            const pieCtx = document.getElementById('purchasePieChart').getContext('2d');

        const pieChart = new Chart(pieCtx, {
          type: 'pie',
          data: {
            labels: ['Sales', 'Sales Return'],
            datasets: [{
              data: [800, 200],
              backgroundColor: ['#4e73df', '#FFAB05']
            }]
          }
        });
          const pieCtx1 = document.getElementById('purchasePieChart1').getContext('2d');

        const pieChart1 = new Chart(pieCtx1, {
          type: 'pie',
          data: {
            labels: ['Sales', 'Purchase'],
            datasets: [{
              data: [5859267, 11133460460],
              backgroundColor: ['#4e73df', '#2D87BB']
            }]
          }
        });
    </script>
}

