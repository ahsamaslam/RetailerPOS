                        </tr>
                        <tr>
                            <th>Total Return</th>
                            <td>$0.00</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <!-- Todays Report Column -->
        <div class="col-lg-4 col-md-12">
