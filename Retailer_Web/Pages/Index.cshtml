<script>

document.addEventListener("DOMContentLoaded", function () {
        const pie_chart_options = { 
        chart: {
          type: 'donut',
        },
            series: @Json.Serialize(Model.SaleSeries),
            labels: @Json.Serialize(Model.SaleLabels),
        dataLabels: {
          enabled: false,
        },
        colors: ['#0d6efd', '#20c997', '#ffc107', '#d63384', '#6f42c1', '#adb5bd'],
      };
        const pie_chart_optionsA = {
            chart: {
                type: 'donut',
            },
            series: @Json.Serialize(Model.PurchaseSeries),
            labels: @Json.Serialize(Model.PurchaseLabels),
            dataLabels: {
                enabled: false,
            },
            colors: [ '#d63384', '#6f42c1', '#adb5bd'],
        };
        const pie_chart_optionsB = {
            chart: {
                type: 'donut',
            },
            series: @Json.Serialize(Model.PurchaseSeries),
            labels: @Json.Serialize(Model.PurchaseLabels),
            dataLabels: {
                enabled: false,
            },
            colors: ['#20c997', '#ffc107', '#d63384'],
        };
      const pie_chart = new ApexCharts(document.querySelector('#pie-chart'), pie_chart_options);
      pie_chart.render();
        const pie_chart1 = new ApexCharts(document.querySelector('#pie-chart1'), pie_chart_optionsA);
        pie_chart1.render();
        const pie_chart2 = new ApexCharts(document.querySelector('#pie-chart2'), pie_chart_optionsB);
        pie_chart2.render();
        const sales_chart_options = {
            series: [
                {
                    name: 'Net Profit',
                    data: [44, 55, 57, 56, 61, 58, 63, 60, 66],
                },
                {
                    name: 'Revenue',
                    data: [76, 85, 101, 98, 87, 105, 91, 114, 94],
                },
                {
                    name: 'Free Cash Flow',
                    data: [35, 41, 36, 26, 45, 48, 52, 53, 41],
                },
            ],
            chart: {
                type: 'bar',
                height: 200,
            },
            plotOptions: {
                bar: {
                    horizontal: false,
                    columnWidth: '55%',
                    endingShape: 'rounded',
                },
            },
            legend: {
                show: false,
            },
            colors: ['#0d6efd', '#20c997', '#ffc107'],
            dataLabels: {
                enabled: false,
            },
            stroke: {
                show: true,
                width: 2,
                colors: ['transparent'],
            },
            xaxis: {
                categories: ['Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct'],
            },
            fill: {
                opacity: 1,
            },
            tooltip: {
                y: {
                    formatter: function (val) {
                        return '$ ' + val + ' thousands';
                    },
                },
            },
        };

        const sales_chart = new ApexCharts(
            document.querySelector('#sales-chart'),
            sales_chart_options,
        );
        sales_chart.render();
    });
</script>