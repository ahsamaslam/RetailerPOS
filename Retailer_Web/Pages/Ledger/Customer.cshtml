@page
@model Retailer.Web.Pages.Ledger.CustomerModel
@{
}
@{
    ViewData["Title"] = "Customer Ledger";
    Layout = "_EmptyLayout";
}

<h2>Customer Ledger</h2> 
 

<main class="app-main">

    <div class="app-content">
        <!-- Anti-forgery token -->
        <form id="antiForgeryForm">
            @Html.AntiForgeryToken()
        </form>

        <div class="row mb-3">
            <div class="col-md-3">
                <label>Start Date</label>
                <select asp-for="CustomerCode" id="status" required asp-items="Model.CustomersList" class="form-control">
                        <option value="">-- Select Customer --</option>
                    </select>
                </div>
            </div> <div class="col-md-3">
                <label>Start Date</label>
                <input asp-for="sdate" type="date" class="form-control" id="startDate" />
            </div>
            <div class="col-md-3">
                <label>End Date</label>
                <input asp-for="edate" type="date" class="form-control" id="endDate" />
            </div>
        </div>

        <table id="myTable" class="table mt-2">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Ref</th>
                    <th>Remarks</th>
                    <th>Debit</th>
                    <th>Credit</th>
                    <th>Balance</th> 
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.ledgers)
                {
                    <tr>
                        <td>@s.Date.ToShortDateString()</td>
                        <td>@s.ReferenceType</td>
                        <td>@s.remarks</td>
                        <td>@s.Debit</td>
                        <td>@s.Credit</td>
                        <td>@s.Balance</td> 
                      
                    </tr>
                }
            </tbody>
        </table>
    </div>

</main>
@section Scripts {
    <script>
        $(function () {

            // Build the handler URL from Razor
            const filterHandlerUrl = '@Url.Page("/Ledger/Customer", "Filtered")';

            function callFilter() {
                const s = $('#startDate').val();
                const e = $('#endDate').val();
                const status = $('#status').val(); 

                const url = `${filterHandlerUrl}?sdate=${s}&edate=${e}&status=${status}&cid=${status}`;
                console.log(url);
                fetch(url)
                    .then(response => {
                        if (!response.ok) throw new Error("Server error");
                        return response.json();
                    })
                    .then(data => {
                        console.log(data);
                        // TODO: render data in your table
                    })
                    .catch(err => console.error("Fetch error:", err));
            }

            $('#startDate, #endDate, #status, #cid').on('change', callFilter);

        });
    </script>
}
