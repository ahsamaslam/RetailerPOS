@page
@model Retailer.Web.Pages.Banks.CreateModel
@{
    ViewData["Title"] = "Create Bank";
}

<main class="app-main">

    

    <!-- Content -->
    <div class="app-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h1 class="mb-0">Create Banks</h1>
                </div>
            </div>
            <div class="row">
                <div class="col-12">

                    <form method="post">

                        <!-- Bank Information -->
                        <div class="row g-3">

                            <!-- Row 1 -->
                            <div class="col-md-8">
                                <label class="form-label">Name</label>
                                <input asp-for="Bank.AccountName" class="form-control" required />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Account Number</label>
                                <input asp-for="Bank.AccountNumber" class="form-control" required />
                            </div>

                            <!-- Row 2 -->
                            <div class="col-md-4">
                                <label class="form-label">Branch Code</label>
                                <input asp-for="Bank.BranchCode" class="form-control" required />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Branch Name</label>
                                <input asp-for="Bank.BrnchName" class="form-control" required />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Mobile</label>
                                <input asp-for="Bank.Mobile" class="form-control" />
                            </div>

                            <!-- Row 3 -->
                            <div class="col-md-4">
                                <label class="form-label">Phone</label>
                                <input asp-for="Bank.Phone" class="form-control" required />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Province</label>
                                <select asp-for="Bank.Province"
                                        asp-items="Model.Provience"
                                        class="form-control"
                                        required>
                                    <option value="">-- Select Province --</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">City</label>
                                <select asp-for="Bank.CityId"
                                        asp-items="Model.Cities"
                                        class="form-control"
                                        required>
                                    <option value="">-- Select City --</option>
                                </select>
                            </div>

                            <!-- Row 4 -->
                            <div class="col-md-12">
                                <label class="form-label">Address</label>
                                <input asp-for="Bank.Address" class="form-control" />
                            </div>

                        </div>

                        <!-- Opening Balance -->
                        <hr class="my-4" />
                        <h4>Opening Balance</h4>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Opening Date</label>
                                <input asp-for="Bank.openDate" type="date" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Opening Balance</label>
                                <input asp-for="Bank.openingBalance" type="number" class="form-control" />
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="mt-4">
                            <button type="submit" class="btn btn-success">Save</button>
                            <a asp-page="Index" class="btn btn-secondary ms-2">Cancel</a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</main>
