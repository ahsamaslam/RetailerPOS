@page
@model Retailer.Web.Pages.Banks.IndexModel
@{
    ViewData["Title"] = "Banks";
    Layout = "_EmptyLayout";
}

<!--begin::Row-->
<div class="row mt-2">
    <div class="col-sm-12">
        <h3 class="mb-0">ViewData["Title"]</h3>
    </div>
</div>

<!--end::Row--> 
<div class="row mb-3">
    <div class="col-md-6">
        <input id="searchBox" class="form-control" placeholder="Search by name..." />
    </div>
    <div class="col-md-6">
        <a asp-page="Create" class="btn btn-primary mb-2">Create New Bank</a>
    </div>
</div>


<main class="app-main"> 
    <div class="app-content container-fluid">
            
         

        <div class="row mt-2">
            <div class="col-12">
                <table class="table table-striped">
    <thead>
        <tr>
            <th>Account Number</th>
            <th>Account Title </th>
            <th>Branch Code</th>
            <th>Branch Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bank in Model.Banks)
        {
            <tr>
                        <td>@bank.AccountName</td>
                        <td>@bank.AccountName</td>
                        <td>@bank.BranchCode</td>
                        <td>@bank.BrnchName</td>
                <td>
                            <a asp-page="Edit" asp-route-id="@bank.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-page="Details" asp-route-id="@bank.Id" class="btn btn-sm btn-info">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
        </div>
        </div> 
        </div>
        </main>