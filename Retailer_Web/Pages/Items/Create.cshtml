@page
@model Retailer.POS.Web.Pages.Items.CreateModel
@{
    ViewData["Title"] = "Create";
    Layout = "_EmptyLayout";
}

<main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
        <!--begin::Container-->
        <div class="container-fluid">
            <!--begin::Row-->
            <div class="row">
                <div class="col-sm-6"><h3 class="mb-0">Create Item</h3></div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
                    </ol>
                </div>
            </div>
            <!--end::Row-->
        </div>
        <!--end::Container-->
    </div>
    <div class="app-content">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="row mb-2">
                <div class="col-md-6">
                <label>Name</label>
                <input asp-for="Input.Name" required class="form-control" />
            </div>
                <div class="col-md-6">
                <label>Barcode</label>
                <input asp-for="Input.Barcode" class="form-control" />
            </div>
                <div class="col-md-6">
                <label>Rate</label>
                    <input asp-for="Input.Rate" type="number" required class="form-control" />
            </div>
                <div class="col-md-6">
                <label>Cost</label>
                <input asp-for="Input.Cost"type="number" required class="form-control" />
            </div>
                <div class="col-md-6">
                <label>Category</label>
                <select asp-for="Input.CategoryId" asp-items="Model.Categories" class="form-control"></select>
            </div>
                <div class="col-md-6">
                <label>Type</label>
                <div class="input-group">
                    <div class="item-type-search dropdown flex-grow-1">
                        <input type="hidden" asp-for="Input.ItemTypeId" id="selectedItemTypeId" />
                        <input type="text" 
                               class="form-control" 
                               id="itemTypeSearchInput" 
                               placeholder="Search or select type..." 
                               autocomplete="off"
                               aria-expanded="false" />
                        <div class="dropdown-menu w-100 p-0" id="itemTypeDropdownMenu">
                            <div class="list-group list-group-flush" id="itemTypeResults">
                                @foreach (var type in Model.ItemType)
                                {
                                    <a href="#" class="list-group-item list-group-item-action" data-id="@type.Value" data-name="@type.Text">
                                        @type.Text
                                    </a>
                                }
                            </div>
                            <div class="dropdown-item text-muted small py-2" id="itemTypeEmptyState">Start typing to search</div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline-primary" data-toggle="modal" data-target="#createItemTypeModal" title="Create New Type">
                        <i class="fa fa-plus"></i>
                    </button>
                </div>
            </div>
                <div class="col-md-6">
                <label>Group</label>
                <select asp-for="Input.GroupId" asp-items="Model.Groups" class="form-control"></select>
            </div>
                <div class="col-md-6">
                <label>SubGroup</label>
                <select asp-for="Input.SubGroupId" asp-items="Model.SubGroups" class="form-control"></select>
            </div>
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </form>
    </div>
    <!--end::App Content-->
</main>
<!--end::App Main-->

<!-- Create Item Type Modal -->
<div class="modal fade" id="createItemTypeModal" tabindex="-1" role="dialog" aria-labelledby="createItemTypeModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createItemTypeModalLabel">Create New Item Type</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="createItemTypeForm">
                    <div class="form-group">
                        <label for="itemTypeName">Type Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="itemTypeName" name="Name" required />
                        <div class="invalid-feedback" id="itemTypeNameError"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveItemTypeBtn">Create Type</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Item Type Searchable Dropdown
    (function() {
        console.log('Initializing Item Type Searchable Dropdown...');

        const searchInput = document.getElementById('itemTypeSearchInput');
        const dropdownMenu = document.getElementById('itemTypeDropdownMenu');
        const resultsContainer = document.getElementById('itemTypeResults');
        const emptyState = document.getElementById('itemTypeEmptyState');
        const hiddenInput = document.getElementById('selectedItemTypeId');

        if (!searchInput || !dropdownMenu || !resultsContainer) {
            console.error('Required elements not found for Item Type dropdown');
            return;
        }

        const allItems = Array.from(resultsContainer.querySelectorAll('.list-group-item'));
        console.log('Found', allItems.length, 'item types');

        // Show dropdown on focus
        searchInput.addEventListener('focus', function() {
            dropdownMenu.classList.add('show');
            searchInput.setAttribute('aria-expanded', 'true');
            filterItems('');
        });

        // Hide dropdown on blur (with delay to allow click)
        searchInput.addEventListener('blur', function() {
            setTimeout(() => {
                dropdownMenu.classList.remove('show');
                searchInput.setAttribute('aria-expanded', 'false');
            }, 200);
        });

        // Filter items on input
        searchInput.addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase().trim();
            filterItems(searchTerm);
        });

        // Handle item selection
        resultsContainer.addEventListener('click', function(e) {
            e.preventDefault();
            const item = e.target.closest('.list-group-item');
            if (item) {
                const id = item.getAttribute('data-id');
                const name = item.getAttribute('data-name');
                selectItemType(id, name);
            }
        });

        function filterItems(searchTerm) {
            let visibleCount = 0;

            allItems.forEach(item => {
                const name = item.getAttribute('data-name').toLowerCase();
                const matches = !searchTerm || name.includes(searchTerm);

                if (matches) {
                    item.style.display = '';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            if (visibleCount === 0) {
                emptyState.textContent = 'No matching types found';
                emptyState.style.display = '';
            } else {
                emptyState.style.display = 'none';
            }
        }

        function selectItemType(id, name) {
            console.log('Selected Item Type:', id, name);
            hiddenInput.value = id;
            searchInput.value = name;
            dropdownMenu.classList.remove('show');
            searchInput.setAttribute('aria-expanded', 'false');
        }

        // Allow clearing the selection
        searchInput.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                dropdownMenu.classList.remove('show');
                searchInput.setAttribute('aria-expanded', 'false');
            }
        });

        console.log('✅ Item Type Searchable Dropdown initialized');
    })();

    // Create Item Type Modal Handler
    (function() {
        console.log('=== Item Type Modal Handler START ===');

        // Wait for DOM to be fully loaded
        if (document.readyState === 'loading') {
            console.log('DOM not ready, waiting...');
            document.addEventListener('DOMContentLoaded', initModal);
        } else {
            console.log('DOM ready, initializing...');
            initModal();
        }

        function initModal() {
            console.log('Initializing modal handler...');

            const modal = $('#createItemTypeModal');
            const form = document.getElementById('createItemTypeForm');
            const saveBtn = document.getElementById('saveItemTypeBtn');
            const nameInput = document.getElementById('itemTypeName');
            const nameError = document.getElementById('itemTypeNameError');
            const dropdown = document.getElementById('itemTypeDropdown');
            const searchInput = document.getElementById('itemTypeSearch');

            console.log('Element check:', {
                'modal (jQuery)': modal.length,
                'form': !!form,
                'saveBtn': !!saveBtn,
                'nameInput': !!nameInput,
                'nameError': !!nameError,
                'dropdown': !!dropdown,
                'searchInput': !!searchInput,
                'jQuery loaded': typeof $ !== 'undefined'
            });

            if (!saveBtn) {
                console.error('❌ Save button not found! Cannot continue.');
                return;
            }

            if (modal.length === 0) {
                console.error('❌ Modal not found! Cannot continue.');
                return;
            }

            // CRITICAL: Prevent form submission
            if (form) {
                form.addEventListener('submit', function(e) {
                    console.log('Form submit prevented');
                    e.preventDefault();
                    e.stopPropagation();
                    return false;
                });
            }

            // Attach click handler to save button
            saveBtn.addEventListener('click', handleSave);
            console.log('✅ Click handler attached to save button');

            // Reset form when modal is closed
            modal.on('hidden.bs.modal', function() {
                console.log('Modal closed, resetting form');
                if (form) form.reset();
                if (nameInput) nameInput.classList.remove('is-invalid');
                if (nameError) nameError.textContent = '';
            });

            console.log('=== Item Type Modal Handler READY ===');
        }

        async function handleSave(event) {
            console.log('💾 SAVE BUTTON CLICKED!');
            event.preventDefault();
            event.stopPropagation();

            const nameInput = document.getElementById('itemTypeName');
            const nameError = document.getElementById('itemTypeNameError');
            const hiddenInput = document.getElementById('selectedItemTypeId');
            const searchInput = document.getElementById('itemTypeSearchInput');
            const resultsContainer = document.getElementById('itemTypeResults');
            const saveBtn = document.getElementById('saveItemTypeBtn');
            const modal = $('#createItemTypeModal');

            // Reset validation
            if (nameInput) nameInput.classList.remove('is-invalid');
            if (nameError) nameError.textContent = '';

            const name = nameInput?.value?.trim();
            console.log('📝 Type name entered:', name || '(empty)');

            if (!name) {
                console.warn('⚠️ Validation failed: Name is empty');
                if (nameInput) nameInput.classList.add('is-invalid');
                if (nameError) nameError.textContent = 'Type name is required';
                return;
            }

            // Disable button during save
            const originalButtonText = saveBtn.innerHTML;
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Creating...';
            console.log('🔒 Button disabled');

            try {
                const url = '@Url.Page("/Items/Create", "CreateItemType")';
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                console.log('🌐 Making API call...');
                console.log('   URL:', url);
                console.log('   Token:', token ? '✅ Found' : '❌ NOT FOUND');
                console.log('   Body:', JSON.stringify({ name: name }));

                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    body: JSON.stringify({ name: name })
                });

                console.log('📡 Response received:');
                console.log('   Status:', response.status);
                console.log('   OK:', response.ok);
                console.log('   Status Text:', response.statusText);

                if (!response.ok) {
                    console.error('❌ Response not OK');
                    const errorText = await response.text();
                    console.error('   Error text:', errorText);
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }

                const result = await response.json();
                console.log('📦 Response JSON:', result);

                if (result.success) {
                    console.log('✅ SUCCESS! Item Type created');
                    console.log('   ID:', result.id);
                    console.log('   Name:', result.name);

                    // Add new item to dropdown results
                    if (resultsContainer) {
                        const newItem = document.createElement('a');
                        newItem.href = '#';
                        newItem.className = 'list-group-item list-group-item-action';
                        newItem.setAttribute('data-id', result.id);
                        newItem.setAttribute('data-name', result.name);
                        newItem.textContent = result.name;

                        // Add click handler
                        newItem.addEventListener('click', function(e) {
                            e.preventDefault();
                            if (hiddenInput) hiddenInput.value = result.id;
                            if (searchInput) searchInput.value = result.name;
                        });

                        resultsContainer.appendChild(newItem);
                        console.log('✅ Added to dropdown results');
                    }

                    // Select the newly created type
                    if (hiddenInput) hiddenInput.value = result.id;
                    if (searchInput) searchInput.value = result.name;
                    console.log('✅ Type selected');

                    // Close modal
                    console.log('🔐 Closing modal...');
                    modal.modal('hide');

                    // Reset form
                    const form = document.getElementById('createItemTypeForm');
                    if (form) {
                        form.reset();
                        console.log('✅ Form reset');
                    }

                    // Show success message
                    console.log('🎉 Showing success notification');
                    showNotification('Item Type "' + result.name + '" created successfully!', 'success');
                } else {
                    console.error('❌ API returned error:', result.message);
                    if (nameInput) nameInput.classList.add('is-invalid');
                    if (nameError) nameError.textContent = result.message || 'Failed to create Item Type';
                }
            } catch (error) {
                console.error('❌ Error during save:', error);
                console.error('   Error name:', error.name);
                console.error('   Error message:', error.message);
                console.error('   Stack:', error.stack);

                if (nameInput) nameInput.classList.add('is-invalid');
                if (nameError) nameError.textContent = 'An error occurred: ' + error.message;
            } finally {
                saveBtn.disabled = false;
                saveBtn.innerHTML = originalButtonText;
                console.log('🔓 Button re-enabled');
            }
        }

        function showNotification(message, type) {
            console.log('📢 Notification:', type, '-', message);
            if (typeof notyf !== 'undefined') {
                if (type === 'success') notyf.success(message);
                else notyf.error(message);
            } else {
                alert(message);
            }
        }
    })();
</script>


