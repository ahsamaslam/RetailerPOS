@page
@model Retailer.POS.Web.Pages.Items.IndexModel
@{
    ViewData["Title"] = "Items";
    Layout = "_EmptyLayout";
}
<h2>Items</h2>
<div class="row mb-3">
    <div class="col-md-6">
        <input id="searchBox" class="form-control" placeholder="Search by name..." />
    </div>
    <div class="col-md-6">
        <a asp-page="Create" class="btn btn-primary mb-2">Create New Item</a>
    </div>
</div>


<table id="myTable" class="table mt-2">
    <thead>
        <tr>
            <th>Name</th>
            <th>Barcode</th>
            <th>Rate</th>
            <th>Cost</th>
            <th>Category</th>
            <th>Group</th>
            <th>SubGroup</th>
            <th>Type</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var it in Model.Items)
        {
            <tr>
                <td>@it.Name</td>
                <td>@it.Barcode</td>
                <td>@it.Rate</td>
                <td>@it.Cost</td>
                <td>@it.CategoryName</td>
                <td>@it.GroupName</td>
                <td>@it.SubGroupName</td>
                <td>@it.ItemTypeName</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@it.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-page="Details" asp-route-id="@it.Id" class="btn btn-sm btn-info">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<!--end::App Main-->
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#myTable').DataTable({
                "paging": true,
                "searching": true,
                "ordering": true,
                "info": true
            });
        });
    </script>
}
