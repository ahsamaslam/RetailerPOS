@page
@model Retailer.POS.Web.Pages.Vendors.IndexModel
@inject Retailer.POS.Web.Services.IApiClient ApiClient
@{
    ViewData["Title"] = "Vendor";
    Layout = "_EmptyLayout";
}
<h2>Vendors</h2>
<div class="row mb-3">
    <div class="col-md-6">
        <input id="searchBox" class="form-control" placeholder="Search by name..." />
    </div>
    <div class="col-md-6">
        <a asp-page="Create" class="btn btn-primary mb-2">Create New Vendor</a>
    </div>
</div>



<table class="table table-striped mt-2">
    <thead>
        <tr>
            <th>Name</th>
            <th>Mobile</th>
            <th>City</th>
            <th>Province</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var vendor in Model.Vendors)
        {
            <tr>
                <td>@vendor.Name</td>
                <td>@vendor.Mobile</td>
                <td>@vendor.City</td>
                <td>@vendor.Province</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@vendor.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-page="Details" asp-route-id="@vendor.Id" class="btn btn-sm btn-info">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>