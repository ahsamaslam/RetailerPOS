@page "{id:int}"
@model Retailer.POS.Web.Pages.Vendors.EditModel
@inject Retailer.POS.Web.Services.IApiClient ApiClient
@{
    ViewData["Title"] = "Edit";
    Layout = "_EmptyLayout";
}
<h2>Edit Vendor</h2>

<form method="post">
    <input type="hidden" asp-for="Vendor.Id" />
    <div class="row mb-2">
        <div class="col-md-4">
            <label>Payment Type</label>
            <select asp-for="Vendor.PaymentType" required asp-items="Model.PaymentType" class="form-control">
                <option value="">-- Select Type --</option>
            </select>
        </div>
        <div class="col-md-8">

            <label>Name</label>
            <input asp-for="Vendor.Name" required class="form-control" />
        </div>
        <div class="col-md-4">
            <label>Mobile</label>
            <input asp-for="Vendor.Mobile" class="form-control" />
        </div>
        <div class="col-md-4">
            <label>Phone</label>
            <input asp-for="Vendor.Phone" class="form-control" />
        </div>
        <div class="col-md-4">
            <label>NTN</label>
            <input asp-for="Vendor.NTN" class="form-control" />
        </div>
        <div class="col-md-4">
            <label>STRN</label>
            <input asp-for="Vendor.STRN" class="form-control" />
        </div>

        <div class="col-md-4">
            <label>Province</label>
            <select asp-for="Vendor.Province" required asp-items="Model.Provience" class="form-control">
                <option value="">-- Select Provience --</option>
            </select>
        </div>
        <div class="col-md-4">
            <label>City</label>
            <select asp-for="Vendor.CityId" required asp-items="Model.Cities" class="form-control">
                <option value="">-- Select City --</option>
            </select>
        </div>
        <div class="col-md-12">
            <label>Address </label>
            <input asp-for="Vendor.Address" required class="form-control" />
        </div>
    </div>
    <div class="row mb-2"><h4 class="mb-0">Opening Balance</h4></div>
    <div class="row mb-2">
        <div class="col-md-4">
            <label>Opening Date </label>
            <input asp-for="Vendor.openDate" class="form-control" />
        </div>
        <div class="col-md-4">
            <label>Opening Balance </label>
            <input asp-for="Vendor.openingBalance" type="number" class="form-control" />
        </div>
        <div class="col-md-4">
            <input asp-for="Vendor.Register" class="form-check-input" type="checkbox" />
            <label asp-for="Vendor.Register" class="form-check-label">Sales Tax Registered</label>
        </div>
    </div>
    <button type="submit" class="btn btn-success">Update</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
