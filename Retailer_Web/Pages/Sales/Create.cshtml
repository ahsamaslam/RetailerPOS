   //                  e.target.value = maxQty;
   //              }
   //          }
   //      }

			 // calculateRowAmount(row);
			 // updateTotal();
   //  }
			// });
			function updateTotal() {
				const rows = detailsTbody.querySelectorAll('tr[data-index]');
				let total = 0;
				let subtotal = 0;
				let totalTax = 0;
				let totalQty = 0;
				let totaleTax = 0;
				let totaleFTax = 0;
				rows.forEach(row => {
					//console.log(row);
					const rowAmounts = calculateRowAmount(row);
					total += rowAmounts.total;
					subtotal += rowAmounts.amount;
					totalTax += rowAmounts.taxAmount;
					totalQty += rowAmounts.qty;
					totaleTax += rowAmounts.etaxAmount;
					totaleFTax += rowAmounts.ftaxAmount;
				});

				const totalQtyCell = document.querySelector('.total-qty td');
				if (totalQtyCell) totalQtyCell.textContent = `${Number(totalQty).toLocaleString()}`;
				const totaltaxCell = document.querySelector('.total-tax td');
				if (totaltaxCell) totaltaxCell.textContent = `${Number(totalTax).toLocaleString()}`;

				const totaletaxCell = document.querySelector('.total-edtax td');
				if (totaletaxCell) totaletaxCell.textContent = `${Number(totaleTax).toLocaleString()}`;

				const totalfedtaxCell = document.querySelector('.total-fedtax td');
				if (totalfedtaxCell) totalfedtaxCell.textContent = `${Number(totaleFTax).toLocaleString()}`;
				const subtotalCell = document.querySelector('.sub-total td');
				if (subtotalCell) subtotalCell.textContent = `${Number(subtotal).toLocaleString()}`;
				// Update total in the summary table
				const totalCell = document.querySelector('.total-amount td h2');
				if (totalCell) totalCell.textContent = `${Number(total).toLocaleString()}`;
			}
			function calculateRowAmount(row) {
				const rate = parseFloat(row.querySelector('input[name$=".Rate"]').value) || 0;
				const qty = parseFloat(row.querySelector('input[name$=".Qty"]').value) || 0;
				const discount = parseFloat(row.querySelector('input[name$=".Discount"]').value) || 0;
				const tax = parseFloat(row.querySelector('input[name$=".TaxPercentage"]').value) || 0;
				const etax = parseFloat(row.querySelector('input[name$=".extraTaxP"]').value) || 0;
				const ftax = parseFloat(row.querySelector('input[name$=".furtherTaxP"]').value) || 0;
				// Amount calculation: (Rate * Qty) - Discount + Tax%
				let amount = (rate * qty);
				const taxAmount = (amount * tax / 100);
				const etaxAmount = (amount * etax / 100);
				const ftaxAmount = (amount * ftax / 100);
				let total = amount - discount;

				total += taxAmount + etaxAmount + ftaxAmount;
				console.log(amount);

				const subTotal = row.querySelector('input[name$=".subTotal"]');
				subTotal.value = amount.toFixed(2);
				const taxAmountInput = row.querySelector('input[name$=".TaxAmount"]');
				taxAmountInput.value = taxAmount.toFixed(2);
				const etaxAmountInput = row.querySelector('input[name$=".extraTax"]');
				etaxAmountInput.value = etaxAmount.toFixed(2);
				const ftaxAmountInput = row.querySelector('input[name$=".furtherTax"]');
				ftaxAmountInput.value = ftaxAmount.toFixed(2);
				const amountInput = row.querySelector('input[name$=".Amount"]');
				amountInput.value = total.toFixed(2);
				return {
					amount,
					taxAmount,
					total,
					qty,
					etaxAmount,
					ftaxAmount
				};
			}
			const form = document.getElementById('saleForm');
			form?.addEventListener('submit', function () {
				reindexRows();
			});

			reindexRows();
			document.querySelectorAll('input[name$=".TaxPercentage"]').forEach(i => {
				i.value = defaultGST;
			});
			document.querySelectorAll('input[name$=".extraTaxP"]').forEach(i => {
				i.value = defaultED;
			});
			document.querySelectorAll('input[name$=".furtherTaxP"]').forEach(i => {
				i.value = defaultFed;
			});
		})();
	</script>
}
