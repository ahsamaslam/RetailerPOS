@page
@model Retailer.POS.Web.Pages.Sales.CreateModel
@{
	ViewData["Title"] = "Create Sale";
	Layout = "_EmptyLayout";
}
<style>
	.table-scroll-x {
		overflow-x: auto; /* Enables horizontals scrollbar */
		white-space: nowrap; /* Prevent table from wrapping */
		width: 100%; /* Responsive */
		border: 1px solid #ddd; /* Optional */
	}

	.right-table th,
	.right-table td {
		padding: 4px 6px !important;
		vertical-align: middle;
	}
	.right-table tr {
    margin: 0 !important;
    height: auto;
} 
</style>
<main class="app-main">
	<!--begin::App Content Header-->
	<div class="app-content-header">
		<!--begin::Container-->
		<div class="container-fluid">
			<!--begin::Row-->
			<div class="row">
				<div class="col-sm-6"><h3 class="mb-0">Create Sales</h3></div>
				 
			</div>
			<!--end::Row-->
		</div>
		<!--end::Container-->
	</div>
	<div class="app-content">

		<form method="post" id="saleForm">
			<input type="hidden" asp-for="@Model.company.isGst" id="isGstEnabled" value="@Model.company.isGst" />
			<input type="hidden" id="isFedEnabled" asp-for="@Model.company.isFed" />
			<input type="hidden" id="isEdEnabled" asp-for="@Model.company.isEd" />
			<input type="hidden" id="gstValue" asp-for="@Model.company.gstVal" />
			<input type="hidden" id="edValue" asp-for="@Model.company.edVal" />
			<input type="hidden" id="fedValue" asp-for="@Model.company.fedVal" />
			<div class="row">
				<div class="col-md-4 mb-2">
					 
							<div class="mb-2"> 
								<input asp-for="Sale.Date" type="date" class="form-control text-start" autofocus />
							</div>
							<div class="mb-2"> 
								<select asp-for="Sale.SaleType" required asp-items="Model.SaleType" class="form-control">
									<option value="">-- Select Type --</option>
								</select>
							</div>
							<div class="mb-2"> 
								<select asp-for="Sale.CustomerCode" required asp-items="Model.CustomersList" class="form-control">
									<option value="">-- Select Customer --</option>
								</select>
							</div>
					 
					<table class="table table-sm right-table">

						<tbody>
						</tbody>
					</table>
				</div>
				<div class="col-md-4 mb-2">
					<table class="table table-sm right-table">

						<tbody>


							<tr class="d-flex align-items-center justify-content-between">
								<th class="border-0 ">
									<div class="d-flex align-items-center font-size-h5 mb-0 font-size-bold text-dark">
										Closing Balance


									</div>
								</th>
								<td class="border-0 justify-content-end d-flex text-dark font-size-base">10%</td>

							</tr>
						</tbody>
					</table>
				</div>
				<div class="col-md-4 mb-2">
				<table class="table table-sm right-table summary-table">
    <tbody>
        <tr class="summary-row sub-total">
            <th>Sub total</th>
            <td>0</td>
        </tr>

        <tr class="summary-row total-tax gst-tax">
            <th>Total GST</th>
            <td>0</td>
        </tr>

        <tr class="summary-row total-edtax ed-tax">
            <th>Total E-Tax</th>
            <td>0</td>
        </tr>

        <tr class="summary-row total-fedtax fed-tax">
            <th>Total F-Tax</th>
            <td>0</td>
        </tr>

        <!-- Divider above TOTAL -->
        <tr class="summary-divider">
            <td colspan="2"></td>
        </tr>

        <tr class="summary-row total-amount">
            <th class="total-label">TOTAL</th>
            <td class="total-value">0</td>
        </tr>
    </tbody>

    <tfoot>
        <tr class="summary-actions">
            <td colspan="2">
                <button type="submit" class="btn btn-primary btn-sm" accesskey="s">
                    Save Sale
                </button>
                <a asp-page="Index" class="btn btn-secondary btn-sm">
                    Cancel
                </a>
            </td>
        </tr>
    </tfoot>
</table>

				</div>

				<div class="col-md-12 mb-2">
					<div class="table-scroll-x">
						<table class="table table-sm" id="detailsTable">
							<thead class="table-light">
								<tr>
									<th width="5%">Sr</th>
									<th width="20%">Item</th>
									<th width="7%">Rate</th>
									<th width="7%">Qty</th>
									<th width="10%">Sub Total</th>
									<th width="7%">Discount</th>
									<th width="5%" class="gst-tax">GST %</th>
									<th width="7%" class="gst-tax">GST </th>
									<th width="5%" class="ed-tax">E-Tax %</th>
									<th width="7%" class="ed-tax">E-Tax </th>
									<th width="5%" class="fed-tax">F-Tax %</th>
									<th width="7%" class="fed-tax">F-Tax </th>
									<th width="15%">Total</th>

									<th></th>
								</tr>
							</thead>
							<tbody>
								@for (int i = 0; i < Model.Sale.Details.Count; i++)
								{
									<tr data-index="@i">
										<td>
											<label class="sr-no-label">1</label>
										</td>
										<td>
											<select asp-for="Sale.Details[i].ItemCode" class="form-control item-select" data-index="@i">
												<option value="">-- Select Item --</option>
												@foreach (var item in Model.ItemsList)
												{
													<option value="@item.Value" data-rate="@item.rate" data-qty="@item.qty">@item.Text</option>
												}
											</select>
										</td>
										<td><input asp-for="Sale.Details[i].Rate" min="0" type="number" step="0.01" class="form-control text-end" /></td>
										<td><input asp-for="Sale.Details[i].Qty" min="0" type="number" step="0.01" class="form-control text-end" /></td>
										<td><input asp-for="Sale.Details[i].subTotal" type="number" step="0.01" class="form-control text-end fw-bold" /></td>
										<td><input asp-for="Sale.Details[i].Discount" min="0" max="100" type="number" step="0.01" class="form-control text-end" /></td>
										<td class="gst-tax"><input asp-for="Sale.Details[i].TaxPercentage" min="0" max="100" type="number" step="0.01" class="form-control text-end" /></td>
										<td class="gst-tax"><input asp-for="Sale.Details[i].TaxAmount" readonly type="number" step="0.01" class="form-control text-end" /></td>
										<td class="ed-tax"><input asp-for="Sale.Details[i].extraTaxP" min="0" max="100" type="number" step="0.01" readonly class="form-control text-end" /></td>
										<td class="ed-tax"><input asp-for="Sale.Details[i].extraTax" type="number" step="0.01" class="form-control readonly text-end" /></td>
										<td class="fed-tax"><input asp-for="Sale.Details[i].furtherTaxP" min="0" max="100" type="number" step="0.01" readonly class="form-control text-end" /></td>
										<td class="fed-tax"><input asp-for="Sale.Details[i].furtherTax" type="number" step="0.01" readonly class="form-control text-end" /></td>
										<td><input asp-for="Sale.Details[i].Amount" readonly type="number" step="0.01" class="form-control text-end fw-bold" /></td>

										<td><button type="button" class="btn btn-danger btn-sm remove-row">Remove</button></td>
									</tr>
								}
								<tr id="templateRow" style="display:none">
									<td>
										<label class="sr-no-label">__index__</label>
									</td>
									<td>

										<select name="Sale.Details[__index__].ItemCode" asp-items="Model.ItemsList" class="form-control">
											<option value="">-- Select Item --</option>
										</select>
									</td>
									<td><input name="Sale.Details[__index__].Rate" min="0" value="0" type="number" step="0.01" class="form-control text-end" /></td>
									<td><input name="Sale.Details[__index__].Qty" min="0" type="number" value="0" step="0.01" class="form-control text-end" /></td>
									<td><input name="Sale.Details[__index__].subTotal" type="number" value="0" step="0.01" class="form-control text-end fw-bold" /></td>
									<td><input name="Sale.Details[__index__].Discount" min="0" max="100" type="number" value="0" step="0.01" class="form-control text-end" /></td>
									<td class="gst-tax"><input name="Sale.Details[__index__].TaxPercentage" min="0" max="100" type="number" value="0" step="0.01" class="form-control text-end" /></td>
									<td class="gst-tax"><input name="Sale.Details[__index__].TaxAmount" readonly type="number" value="0" step="0.01" class="form-control text-end" /></td>
									<td class="ed-tax"><input name="Sale.Details[__index__].extraTaxP" min="0" max="100"  type="number" value="0" step="0.01" class="form-control text-end" /></td>
									<td class="ed-tax"><input name="Sale.Details[__index__].extraTax" readonly type="number" value="0" step="0.01" class="form-control text-end" /></td>
									<td class="ed-tax"><input name="Sale.Details[__index__].furtherTaxP" min="0" max="100" type="number" value="0" step="0.01" class="form-control text-end" /></td>
									<td class="ed-tax"><input name="Sale.Details[__index__].furtherTax" readonly type="number" value="0" step="0.01" class="form-control text-end" /></td>

									<td><input name="Sale.Details[__index__].Amount" type="number" value="0" step="0.01" class="form-control text-end fw-bold" /></td>
									<td><button type="button" class="btn btn-danger btn-sm remove-row">Remove</button></td>
								</tr>

							</tbody>
							<tfoot>
								<tr class="d-flex align-items-center justify-content-between total-qty">

									<th class="border-0 font-size-h5 mb-0 font-size-bold text-dark">
										Total Items
									</th>
									<td class="border-0 justify-content-end d-flex text-dark font-size-base">0</td>

								</tr>
							</tfoot>
						</table>
					</div>
					<button type="button" id="addRow" class="btn btn-sm btn-secondary mb-2" accesskey="a">Add Item</button>
				</div>

			</div>

		</form>
	</div>
</main>
@section Scripts {
	<script>
		(function () {
			const detailsTbody = document.querySelector('#detailsTable tbody');
			const templateRow = document.getElementById('templateRow');
			const templateInnerHtml = templateRow.innerHTML;
			const isGst = document.getElementById("isGstEnabled").value === "True";
			const isEd = document.getElementById("isEdEnabled").value === "True";
			const isFed = document.getElementById("isFedEnabled").value === "True";
			const defaultGST = (isGst) ? parseFloat(document.getElementById("gstValue").value) || 0 : 0;
			const defaultED = (isEd) ? parseFloat(document.getElementById("edValue").value) || 0 : 0;
			const defaultFed = (isFed) ? parseFloat(document.getElementById("fedValue").value) || 0 : 0;
			function dataRows() {
				return Array.from(detailsTbody.querySelectorAll('tr'))
					.filter(r => r.id !== 'templateRow');
			}

			function reindexRows() {
				const rows = dataRows();
				rows.forEach((row, idx) => {
					row.setAttribute('data-index', idx);
					row.querySelectorAll('input, select, textarea').forEach(inp => {
						// Update name attributes (handles previously numbered names)
						const nameAttr = inp.getAttribute('name');
						if (nameAttr) {
							// Replace any bracketed index or __index__ placeholder
							const newName = nameAttr
								.replace(/Sale\.Details\[(?:\d+|__index__)\]/g, `Sale.Details[${idx}]`);
							inp.setAttribute('name', newName);
						}
						// Update id if it exists with the pattern _Details_x_
						if (inp.id) {
							inp.id = inp.id.replace(/_Details_\d+_/g, `_Details_${idx}_`);
						}
					});

					// update any visible index labels
					const srLabel = row.querySelector('.sr-no-label');
					if (srLabel) srLabel.textContent = (idx + 1).toString();
				});
			}
			function toggleFed() {


				document.querySelectorAll('.fed-tax').forEach(col => {
					col.style.display = isFed ? "" : "none";
				});

				if (!isFed) {
					document.querySelectorAll('.furtherTaxP').forEach(t => t.value = 0);
					document.querySelectorAll('input[name$=".furtherTax"]').forEach(t => t.value = 0);
				}
			}
			function toggleGst() {


				document.querySelectorAll('.gst-tax').forEach(col => {
					col.style.display = isGst ? "" : "none";
				});

				if (!isGst) {
					document.querySelectorAll('.tax-percentage').forEach(t => t.value = 0);
					document.querySelectorAll('input[name$=".TaxAmount"]').forEach(t => t.value = 0);
				}
			}
			function toggleEd() {


				document.querySelectorAll('.ed-tax').forEach(col => {
					col.style.display = isEd ? "" : "none";
				});

				if (!isEd) {
					document.querySelectorAll('.extraTaxP').forEach(t => t.value = 0);
					document.querySelectorAll('input[name$=".extraTax"]').forEach(t => t.value = 0);
				}
			}
			function toggleAll() {
				toggleGst();
				toggleEd();
				toggleFed();
			}
			toggleAll();
			document.getElementById('addRow').addEventListener('click', function () {

				const index = detailsTbody.children.length;
				const tr = document.createElement('tr');
				tr.setAttribute('data-index', index);
				tr.innerHTML = templateInnerHtml.replace(/__index__/g, index);
				console.log(tr);
				detailsTbody.appendChild(tr);
				toggleAll();
				const taxInput = tr.querySelector('input[name$=".TaxPercentage"]');
				if (taxInput) {
					taxInput.value = defaultGST;
				}
				const etaxInput = tr.querySelector('input[name$=".extraTaxP"]');
				if (etaxInput) {
					etaxInput.value = defaultED;
				}
				const ftaxInput = tr.querySelector('input[name$=".furtherTaxP"]');
				if (ftaxInput) {
					ftaxInput.value = defaultFed;
				}
				const itemSelect = tr.querySelector('select');
				if (itemSelect) {
					itemSelect.focus();
				}

			});
			document.querySelector('#detailsTable').addEventListener('change', function (e) {
				if (e.target && e.target.classList.contains('item-select')) {
					var selectedOption = e.target.selectedOptions[0];
					var rate = selectedOption.getAttribute('data-rate') || 0;
					var cqty = selectedOption.getAttribute('data-qty') || 0;

					console.log(cqty);
					// Find the row and corresponding Rate input
					var row = e.target.closest('tr');
					var rateInput = row.querySelector('input[name*=".Rate"]');
					if (rateInput) {
						rateInput.value = parseFloat(rate).toFixed(2);
					}

					// Optionally, trigger recalculation for subTotal/Amount
					// calculateRowAmount(row);
				}
			});
			document.addEventListener('click', function (e) {
				if (e.target && e.target.classList.contains('remove-row')) {
					const row = e.target.closest('tr');
					const elements = row.querySelectorAll('[data-index]');
					console.log(elements);
					if (row) row.remove();
					reindexRows();
					updateTotal();
				}
			});
			detailsTbody.addEventListener('input', function (e) {
				const row = e.target.closest('tr');
				 if (row) {
        // Check if qty input changed
        if (e.target.classList.contains('qty-input')) {
            const selectedOption = row.querySelector('select.item-select')?.selectedOptions[0];
            if (selectedOption) {
                const maxQty = parseFloat(selectedOption.getAttribute('data-qty')) || 0;
                let enteredQty = parseFloat(e.target.value) || 0;
                if (enteredQty > maxQty) {
                    alert(`Quantity cannot exceed available stock (${maxQty}).`);
                    e.target.value = maxQty;
                }
            }
        }

        calculateRowAmount(row);
        updateTotal();
    }
			});
			function updateTotal() {
				const rows = detailsTbody.querySelectorAll('tr[data-index]');
				let total = 0;
				let subtotal = 0;
				let totalTax = 0;
				let totalQty = 0;
				let totaleTax = 0;
				let totaleFTax = 0;
				rows.forEach(row => {
					//console.log(row);
					const rowAmounts = calculateRowAmount(row);
					total += rowAmounts.total;
					subtotal += rowAmounts.amount;
					totalTax += rowAmounts.taxAmount;
					totalQty += rowAmounts.qty;
					totaleTax += rowAmounts.etaxAmount;
					totaleFTax += rowAmounts.ftaxAmount;
				});

				const totalQtyCell = document.querySelector('.total-qty td');
				if (totalQtyCell) totalQtyCell.textContent = `${Number(totalQty).toLocaleString()}`;
				const totaltaxCell = document.querySelector('.total-tax td');
				if (totaltaxCell) totaltaxCell.textContent = `${Number(totalTax).toLocaleString()}`;

				const totaletaxCell = document.querySelector('.total-edtax td');
				if (totaletaxCell) totaletaxCell.textContent = `${Number(totaleTax).toLocaleString()}`;

				const totalfedtaxCell = document.querySelector('.total-fedtax td');
				if (totalfedtaxCell) totalfedtaxCell.textContent = `${Number(totaleFTax).toLocaleString()}`;
				const subtotalCell = document.querySelector('.sub-total td');
				if (subtotalCell) subtotalCell.textContent = `${Number(subtotal).toLocaleString()}`;
				// Update total in the summary table
				const totalCell = document.querySelector('.total-amount td h2');
				if (totalCell) totalCell.textContent = `${Number(total).toLocaleString()}`;
			}
			function calculateRowAmount(row) {
				const rate = parseFloat(row.querySelector('input[name$=".Rate"]').value) || 0;
				const qty = parseFloat(row.querySelector('input[name$=".Qty"]').value) || 0;
				const discount = parseFloat(row.querySelector('input[name$=".Discount"]').value) || 0;
				const tax = parseFloat(row.querySelector('input[name$=".TaxPercentage"]').value) || 0;
				const etax = parseFloat(row.querySelector('input[name$=".extraTaxP"]').value) || 0;
				const ftax = parseFloat(row.querySelector('input[name$=".furtherTaxP"]').value) || 0;
				// Amount calculation: (Rate * Qty) - Discount + Tax%
				let amount = (rate * qty);
				const taxAmount = (amount * tax / 100);
				const etaxAmount = (amount * etax / 100);
				const ftaxAmount = (amount * ftax / 100);
				let total = amount - discount;

				total += taxAmount + etaxAmount + ftaxAmount;
				console.log(amount);

				const subTotal = row.querySelector('input[name$=".subTotal"]');
				subTotal.value = amount.toFixed(2);
				const taxAmountInput = row.querySelector('input[name$=".TaxAmount"]');
				taxAmountInput.value = taxAmount.toFixed(2);
				const etaxAmountInput = row.querySelector('input[name$=".extraTax"]');
				etaxAmountInput.value = etaxAmount.toFixed(2);
				const ftaxAmountInput = row.querySelector('input[name$=".furtherTax"]');
				ftaxAmountInput.value = ftaxAmount.toFixed(2);
				const amountInput = row.querySelector('input[name$=".Amount"]');
				amountInput.value = total.toFixed(2);
				return {
					amount,
					taxAmount,
					total,
					qty,
					etaxAmount,
					ftaxAmount
				};
			}
			const form = document.getElementById('saleForm');
			form?.addEventListener('submit', function () {
				reindexRows();
			});

			reindexRows();
			document.querySelectorAll('input[name$=".TaxPercentage"]').forEach(i => {
				i.value = defaultGST;
			});
			document.querySelectorAll('input[name$=".extraTaxP"]').forEach(i => {
				i.value = defaultED;
			});
			document.querySelectorAll('input[name$=".furtherTaxP"]').forEach(i => {
				i.value = defaultFed;
			});
		})();
	</script>
}
