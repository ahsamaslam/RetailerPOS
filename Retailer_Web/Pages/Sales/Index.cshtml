    </div>
    <div class="col-md-6">
        <a asp-page="Create" class="btn btn-primary mb-2">Create New Sale</a>
    </div>
</div>


<main class="app-main">
    <!--begin::App Content Header-->
    @* <div class="app-content-header">
        <!--begin::Container-->
        <div class="container-fluid">
            <!--begin::Row-->
            <div class="row mb-3">
                <div class="col-sm-6"><h3 class="mb-0">Categories</h3>
                    <input id="searchBox" class="form-control" placeholder="Search by name..." />
