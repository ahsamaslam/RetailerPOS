@page "{id:int}"
@model Retailer.POS.Web.Pages.Sales.PrintModel
@{
    Layout = null; // Exclude the layout
    ViewData["Title"] = "Sale Details";
}
<div class="ticket">
    <img src="~/assets/img/adminltefulllogo.png" alt="Logo">
    <link href="~/css/printstyle.css" rel="stylesheet" />
    <p class="centered">
        RECEIPT EXAMPLE
        <br>Address line 1
        <br>Address line 2
    </p>
    <table>
        <thead>
            <tr>
                <th class="quantity">Q.</th>
                <th class="description">Description</th>
                <th class="price">$$</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Sale.Details.Count; i++)
							{
            <tr>
                    <td class="quantity">@Model.Sale.Details[i].Qty</td>
                    <td class="description">@Model.Sale.Details[i].ItemName</td>
                    <td class="price">@Model.Sale.Details[i].Rate</td>
            </tr>
                            }
           
        </tbody>
    </table>
    <p class="centered">
        Thanks for your purchase!
        <br>parzibyte.me/blog
    </p>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        window.print();
    });
</script>