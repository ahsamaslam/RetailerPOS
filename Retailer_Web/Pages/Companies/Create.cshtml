@page
@model Retailer.POS.Web.Pages.Companies.CreateModel
@{
    ViewData["Title"] = "Create Company";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<form method="post" class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Company.Name" class="form-label"></label>
                <input asp-for="Company.Name" class="form-control" />
                <span asp-validation-for="Company.Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Company.ShortName" class="form-label"></label>
                <input asp-for="Company.ShortName" class="form-control" />
            </div>
            <div class="col-md-12">
                <label asp-for="Company.Address" class="form-label"></label>
                <input asp-for="Company.Address" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Company.ContactPerson" class="form-label"></label>
                <input asp-for="Company.ContactPerson" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Company.ContactEmail" class="form-label"></label>
                <input asp-for="Company.ContactEmail" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Company.ContactPhone" class="form-label"></label>
                <input asp-for="Company.ContactPhone" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Company.Province" class="form-label"></label>
                <input asp-for="Company.Province" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Company.CNIC" class="form-label"></label>
                <input asp-for="Company.CNIC" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Company.NTN" class="form-label"></label>
                <input asp-for="Company.NTN" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Company.STRN" class="form-label"></label>
                <input asp-for="Company.STRN" class="form-control" />
            </div>

            <div class="col-md-4">
                <div class="form-check mt-4">
                    <input asp-for="Company.IsActive" class="form-check-input" />
                    <label asp-for="Company.IsActive" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-check mt-4">
                    <input asp-for="Company.fbrActive" class="form-check-input" />
                    <label asp-for="Company.fbrActive" class="form-check-label">FBR Active</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-check mt-4">
                    <input asp-for="Company.isGst" class="form-check-input" />
                    <label asp-for="Company.isGst" class="form-check-label">GST Enabled</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-check mt-4">
                    <input asp-for="Company.isEd" class="form-check-input" />
                    <label asp-for="Company.isEd" class="form-check-label">ED Enabled</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-check mt-4">
                    <input asp-for="Company.isFed" class="form-check-input" />
                    <label asp-for="Company.isFed" class="form-check-label">FED Enabled</label>
                </div>
            </div>

            <div class="col-md-4">
                <label asp-for="Company.gstVal" class="form-label"></label>
                <input asp-for="Company.gstVal" class="form-control" type="number" step="0.01" />
            </div>
            <div class="col-md-4">
                <label asp-for="Company.edVal" class="form-label"></label>
                <input asp-for="Company.edVal" class="form-control" type="number" step="0.01" />
            </div>
            <div class="col-md-4">
                <label asp-for="Company.fedVal" class="form-label"></label>
                <input asp-for="Company.fedVal" class="form-control" type="number" step="0.01" />
            </div>

            <div class="col-md-6">
                <label asp-for="Company.pralToken" class="form-label"></label>
                <input asp-for="Company.pralToken" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Company.fbrToken" class="form-label"></label>
                <input asp-for="Company.fbrToken" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Company.invoiceCounter" class="form-label"></label>
                <input asp-for="Company.invoiceCounter" class="form-control" type="number" min="0" />
            </div>
            <div class="col-md-6">
                <label asp-for="Company.invoicePerPage" class="form-label"></label>
                <input asp-for="Company.invoicePerPage" class="form-control" type="number" min="0" />
            </div>
        </div>
    </div>
    <div class="card-footer bg-white d-flex gap-2">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
