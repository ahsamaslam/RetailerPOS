@page
@model Retailer.POS.Web.Pages.Companies.IndexModel
@{
    ViewData["Title"] = "Companies";
}
<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <h2 class="mb-0">@ViewData["Title"]</h2>
        </div>
    </div>

    <div class="row mb-3 align-items-center g-2">
        <div class="col-12 col-md-6">
            <input id="searchBox" class="form-control" placeholder="Search by name..." />
        </div>
        <div class="col-12 col-md-6 text-md-end">
            <a asp-page="Create" class="btn btn-primary">Create New Company</a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Company Type</th>
                        <th>Address</th>
                        <th>Contact Email</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Companies)
                    {
                        <tr>
                            <td>@b.Name</td>
                            <td>@b.CompanyType</td>
                            <td>@b.Address</td>
                            <td>@b.ContactEmail</td>
                            <td>
                                <a asp-page="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-page="Details" asp-route-id="@b.Id" class="btn btn-sm btn-info">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
