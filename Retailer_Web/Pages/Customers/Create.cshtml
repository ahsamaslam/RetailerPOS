@page
@model Retailer.POS.Web.Pages.Customers.CreateModel
@inject Retailer.POS.Web.Services.IApiClient ApiClient
@{
    ViewData["Title"] = "Create";
    Layout = "_EmptyLayout";
}
<h2>Customers</h2>
<div class="row mb-3">
    <div class="col-md-6">
        <input id="searchBox" class="form-control" placeholder="Search by name..." />
    </div>
    <div class="col-md-6">
        <a asp-page="Create" class="btn btn-primary mb-2">Create New Customer</a>
    </div>
</div>


<form method="post">
    <div class="row mb-2">
                <div class="col-md-4">
                    <label>Payment Type</label>
                    <select asp-for="Customer.PaymentType" required asp-items="Model.PaymentType" class="form-control">
                        <option value="">-- Select Type --</option>
                    </select>
                </div>
        <div class="col-md-8">
 
        <label>Name</label>
        <input asp-for="Customer.Name" required class="form-control" />
    </div>
        <div class="col-md-4">
        <label>Mobile</label>
            <input asp-for="Customer.Mobile"   class="form-control" />
    </div>
                <div class="col-md-4">
                    <label>Phone</label>
                    <input asp-for="Customer.Phone"   class="form-control" />
                </div>
                <div class="col-md-4">
                    <label>NTN</label>
                    <input asp-for="Customer.NTN"   class="form-control" />
                </div>
                <div class="col-md-4">
                    <label>STRN</label>
                    <input asp-for="Customer.STRN"   class="form-control" />
                </div>

                <div class="col-md-4">
                    <label>Province</label>
                    <select asp-for="Customer.Province" required asp-items="Model.Provience" class="form-control">
                        <option value="">-- Select Provience --</option>
                    </select>
                </div>
                <div class="col-md-4">
        <label>City</label>
                    <select asp-for="Customer.CityId" required asp-items="Model.Cities" class="form-control">
                        <option value="">-- Select City --</option>
                    </select>
    </div>
                <div class="col-md-12">
                    <label>Address </label>
                    <input asp-for="Customer.Address" required class="form-control" />
                </div>
    </div>
            <div class="row mb-2"><h4 class="mb-0">Opening Balance</h4></div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label>Opening Date </label>
                    <input asp-for="Customer.openDate"   class="form-control" />
                </div>
                <div class="col-md-4">
                    <label>Opening Balance </label>
                    <input asp-for="Customer.openingBalance" type="number"   class="form-control" />
                </div>
                <div class="col-md-4">
                    <input asp-for="Customer.Register" class="form-check-input" type="checkbox" />
                    <label asp-for="Customer.Register" class="form-check-label">Sales Tax Registered</label>
                </div>
            </div>
    <button type="submit" class="btn btn-success">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
</div>
</main>