@page "{id:int}"
@model Retailer.POS.Web.Pages.Customers.EditModel
@inject Retailer.POS.Web.Services.IApiClient ApiClient
 
<main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
        <!--begin::Container-->
        <div class="container-fluid">
            <!--begin::Row-->
            <div class="row">
                <div class="col-sm-6"><h3 class="mb-0">Edit Customer</h3></div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Edit Customer</li>
                    </ol>
                </div>
            </div>
            <!--end::Row-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::App Content Header-->
    <!--begin::App Content-->
    <div class="app-content">
<form method="post">
            <input type="hidden" asp-for="Customer.Id" />
            <div class="row mb-2">
                <div class="col-md-4">
                    <label>Payment Type</label>
                    <select asp-for="Customer.PaymentType" required asp-items="Model.PaymentType" class="form-control">
                        <option value="">-- Select Type --</option>
                    </select>
                </div>
                <div class="col-md-8">

                    <label>Name</label>
                    <input asp-for="Customer.Name" required class="form-control" />
                </div>
                <div class="col-md-4">
                    <label>Mobile</label>
                    <input asp-for="Customer.Mobile" required class="form-control" />
                </div>
                <div class="col-md-4">
                    <label>Phone</label>
                    <input asp-for="Customer.Phone"   class="form-control" />
                </div>
                <div class="col-md-4">
                    <label>NTN</label>
                    <input asp-for="Customer.NTN"   class="form-control" />
                </div>
                <div class="col-md-4">
                    <label>STRN</label>
                    <input asp-for="Customer.STRN"   class="form-control" />
                </div>

                <div class="col-md-4">
                    <label>Province</label>
                    <select asp-for="Customer.Province" required asp-items="Model.Provience" class="form-control">
                        <option value="">-- Select Provience --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label>City</label>
                    <select asp-for="Customer.CityId" required asp-items="Model.Cities" class="form-control">
                        <option value="">-- Select City --</option>
                    </select>
                </div>
                <div class="col-md-12">
                    <label>Address </label>
                    <input asp-for="Customer.Address"   class="form-control" />
                </div>
            </div>
            <div class="row mb-2"><h4 class="mb-0">Opening Balance</h4></div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label>Opening Date </label>
                    <input asp-for="Customer.openDate"   class="form-control" />
                </div>
                <div class="col-md-4">
                    <label>Opening Balance </label>
                    <input asp-for="Customer.openingBalance" type="number"   class="form-control" />
                </div>
                <div class="col-md-4">
                    <input asp-for="Customer.Register" class="form-check-input" type="checkbox" />
                    <label asp-for="Customer.Register" class="form-check-label">Sales Tax Registered</label>
                </div>
            </div>
    <button type="submit" class="btn btn-success">Update</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
</div>
</main>