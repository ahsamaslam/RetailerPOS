@using System.Security.Claims
@using Retailer.Web.ApiDTOs
@using Retailer.Web.Models
@using Retailer.Web.Pages.Admin
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var path = Context.Request.Path;
    bool isAdminSection = path.StartsWithSegments("/admin");
    bool isUsers = path.StartsWithSegments("/admin/user");
    bool isRoles = path.StartsWithSegments("/admin/roles");
    bool isPermissions = path.StartsWithSegments("/admin/permissions");
    const string LayoutUserInfoKey = "_LayoutUserInfo";
    var info = Context.Items[LayoutUserInfoKey] as LayoutUserInfo
               ?? new LayoutUserInfo();
    // menus provided by PageModel via HttpContext.Items["Menus"]
    var menus = HttpContextAccessor.HttpContext?.Items["Menus"] as IEnumerable<MenuDto> ?? Enumerable.Empty<MenuDto>();

    // change this if your permission claim type uses a different name
    string permissionClaimType = "permission";

    // bool HasPermission(IEnumerable<string>? permissionNames)
    // {
    //     if (permissionNames == null || !permissionNames.Any()) return true;
    //     var user = HttpContextAccessor.HttpContext?.User;
    //     if (user == null) return false;
    //     return user.Claims.Any(c => c.Type == permissionClaimType && permissionNames.Contains(c.Value, StringComparer.OrdinalIgnoreCase))
    //            || user.IsInRole("Admin"); // Admin override
    // }

    string currentPath = HttpContextAccessor.HttpContext?.Request.Path.Value?.TrimEnd('/') ?? "";
    bool IsActive(string? route)
    {
        if (string.IsNullOrEmpty(route)) return false;
        var r = route.TrimEnd('/');
        return string.Equals(r, currentPath, StringComparison.OrdinalIgnoreCase)
               || currentPath.StartsWith(r + "/", StringComparison.OrdinalIgnoreCase);
    }

