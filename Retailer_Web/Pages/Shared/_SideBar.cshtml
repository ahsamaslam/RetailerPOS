    //                     <p>@sub.Title</p>
    //                 </a>
    //             }
    //         </li>
    //     }
    // }
}

<aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
    <div class="sidebar-brand">
        <a asp-page="/Index" class="brand-link">
            <img src="~/assets/img/AdminLTELogo.png" alt="Logo" class="brand-image opacity-75 shadow" />
            <span class="brand-text fw-light">POS</span>
        </a>
    </div>

    <div class="sidebar-wrapper">
        <nav class="mt-2" aria-label="Main navigation" id="mainnav">
            <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" data-accordion="false" id="navigation">
                <li class="nav-item">
                    <a asp-page="/Index" class="nav-link active">
                        <i class="nav-icon bi bi-speedometer"></i>
                        <p>Dashboard</p>
                    </a>
                </li>
                @* Dynamic menus *@
                @foreach (var menu in menus.Where(m => m.IsActive).OrderBy(m => m.SortOrder))
                {
                    var menuIcon = !string.IsNullOrEmpty(menu.Icon) ? menu.Icon : "bi bi-circle-fill";

                    <li class="nav-item">
                        @{
                            // If no children, link to first sub-route if present, otherwise '#'
                            var firstRoute = menu.SubMenus?.FirstOrDefault()?.Route;
                            <a class="nav-link @(IsActive(firstRoute) ? "active" : "")" href="@((firstRoute != null && firstRoute.StartsWith("/")) ? firstRoute : (firstRoute != null ? Url.Page(firstRoute) : "#"))">
                                <i class="nav-icon @menuIcon"></i>
                                <p>@menu.Title</p>
                            </a>
                        }
                    </li>
                }
                @if (info.IsAdmin)
                {
                    <li class="nav-item @(isAdminSection ? "menu-open" : "")">
                        <a href="#" class="nav-link @(isAdminSection ? "active" : "")" aria-expanded="@(isAdminSection ? "true" : "false")">
                            <i class="nav-icon bi bi-tools"></i>
                            <p>
                                Admin Panel
                                <i class="nav-arrow bi @(isAdminSection ? "bi-chevron-down" : "bi-chevron-right")"></i>
                            </p>
                        </a>
                        <ul class="nav nav-treeview">
                            <li class="nav-item">
                                <a href="~/admin/user" class="nav-link @(isUsers ? "active" : "")">
                                    <i class="nav-icon bi bi-circle"></i>
                                    <p>Users</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="~/admin/roles" class="nav-link @(isRoles ? "active" : "")">
                                    <i class="nav-icon bi bi-circle"></i>
                                    <p>Roles</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="~/admin/permissions" class="nav-link @(isPermissions ? "active" : "")">
                                    <i class="nav-icon bi bi-circle"></i>
                                    <p>Permission</p>
                                </a>
                            </li>
                        </ul>
                    </li>
                }
            </ul>
        </nav>
    </div>
</aside>
