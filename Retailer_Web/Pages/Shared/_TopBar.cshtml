 @using Retailer.Web.Models
@{
    const string LayoutUserInfoKey = "_LayoutUserInfo";
    var info = Context.Items[LayoutUserInfoKey] as LayoutUserInfo
               ?? new LayoutUserInfo(); // fallback
}

<nav class="app-header navbar navbar-expand bg-body">
    <div class="container-fluid">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                    <i class="bi bi-list"></i>
                </a>
            </li>
            <li class="nav-item d-none d-md-block"><h4>Company Name</h4></li>
        </ul>

        <ul class="navbar-nav ms-auto align-items-center">
            <!-- notifications & fullscreen (kept minimal) -->
            <li class="nav-item">
                <a class="nav-link" href="#" data-lte-toggle="fullscreen">
                    <i data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
                </a>
            </li>


            @* Avatar + Name, clicking avatar opens a small modal *@
            <li class="nav-item">
                <div class="d-flex align-items-center">
                    <button type="button" class="btn p-0 border-0 bg-transparent" data-bs-toggle="modal" data-bs-target="#userModal" aria-label="Open profile">
                        <img src="@info.AvatarUrl" onerror="this.src='@Url.Content("~/assets/img/user2-160x160.jpg")'"
                             class="user-image rounded-circle shadow" alt="User Image" style="width:38px; height:38px; object-fit:cover;" />
                    </button>
                    <span class="ms-2 d-none d-md-inline">@info.UserName</span>
                </div>
            </li>
        </ul>
    </div>
</nav>

@* Modal *@
<div class="modal fade" id="userModal" tabindex="-1" aria-labelledby="userModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="d-flex align-items-center">
                    <img src="@info.AvatarUrl" onerror="this.src='@Url.Content("~/assets/img/user2-160x160.jpg")'"
                         class="rounded-circle shadow me-2" style="width:48px;height:48px;object-fit:cover" alt="User" />
                    <div>
                        <h6 class="mb-0">@info.UserName</h6>
                        <small class="text-muted">Signed in</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="list-group">
                    <a class="list-group-item list-group-item-action" href="~/Account/Profile">
                        <i class="bi bi-person-circle me-2"></i> Profile
                    </a>
                   
                </div>
            </div>

            <div class="modal-footer">
                <form method="post" asp-page="/Index" asp-page-handler="Logout" class="w-100">
                    <button type="submit" class="btn btn-outline-danger w-100">Sign out</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!--end::Header-->