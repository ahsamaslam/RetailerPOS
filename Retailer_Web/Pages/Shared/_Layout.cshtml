@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@await Component.InvokeAsync("NToastNotify")
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>POS Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#007bff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)" />

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;600;700&display=swap" rel="stylesheet" />

    <!-- Vendor CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/styles/overlayscrollbars.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" crossorigin="anonymous" />

    <!-- App CSS -->
    <link rel="stylesheet" href="~/css/adminlte.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/datatables/datatables.min.css" asp-append-version="true" />

    <!-- Optional plugin CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/apexcharts@3.37.1/dist/apexcharts.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jsvectormap@1.5.3/dist/css/jsvectormap.min.css" crossorigin="anonymous" />

    @RenderSection("Head", required: false)
</head>
<body class="layout-fixed sidebar-expand-lg sidebar-open bg-body-tertiary">
    <div class="app-wrapper">
        <partial name="_TopBar" />
        @* Sidebar is rendered via partial component/partial view *@
        <partial name="_Sidebar" />
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <partial name="_Footer" />

    <!-- Vendor scripts (defer heavy libs) -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2/dist/umd/popper.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.min.js" crossorigin="anonymous"></script>

    <!-- AdminLTE -->
    <script src="~/js/adminlte.js" asp-append-version="true"></script>

    <!-- OverlayScrollbars -->
    <script src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/browser/overlayscrollbars.browser.es6.min.js" crossorigin="anonymous"></script>

    <!-- Optional vendor scripts -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.37.1/dist/apexcharts.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsvectormap@1.5.3/dist/js/jsvectormap.min.js" crossorigin="anonymous"></script>

    <!-- DataTables (only once) -->
    <script src="~/lib/datatables/datatables.min.js" asp-append-version="true"></script>

    <!-- App-specific JS: small initializers -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // OverlayScrollbars for sidebar wrapper
            const sidebarWrapper = document.querySelector('.sidebar-wrapper');
            if (sidebarWrapper && window.OverlayScrollbars) {
                OverlayScrollbars(sidebarWrapper, {
                    scrollbars: { theme: 'os-theme-light', autoHide: 'leave', clickScroll: true }
                });
            }

            // Simple Sortable example (if needed)
            const connected = document.querySelector('.connectedSortable');
            if (connected && window.Sortable) {
                new Sortable(connected, { group: 'shared', handle: '.card-header' });
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
