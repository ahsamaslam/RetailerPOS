@await Component.InvokeAsync("NToastNotify")
<!DOCTYPE html>
<html>
<head>
    <partial name="_PageHeadElement" />

    @RenderSection("Styles", required: false)
    @RenderSection("HeadScripts", required: false)
</head>
<body>
    @await Component.InvokeAsync("Sidebar")
    <div class="main-content" id="panel">

        @await Component.InvokeAsync("TopBar")

        <!-- Header -->
        <div class="header navbar-dark pb-2 bg-default">
            <div class="container-fluid">
                <div class="header-body">
                    <!-- 1st Row: Crumbs and filters -->
                    <div class="row">
                        <div class="col-lg-7 col-md-10">
                            <h1 class="display-2 text-white">Hello,</h1>
                            <p class="text-white mt-0 mb-5">
                                This is your profile page. You can see the progress you've made with your work and manage
                                your projects or assigned tasks
                            </p>
                        </div>
                    </div>
                    @RenderSection("DashboardCards", required: false)
                </div>
            </div>
        </div>

        <!-- / Header -->
        <!-- Page content -->
        <div class="container-fluid mt-4 pt-4">
            @RenderBody()
            <partial name="_Footer" />
        </div>
      
      
    </div>
  
    <partial name="_ThemeScripts" />

    @RenderSection("Scripts", required: false)
</body>
</html>
