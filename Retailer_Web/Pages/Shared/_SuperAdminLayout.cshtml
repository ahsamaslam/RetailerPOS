@using Microsoft.AspNetCore.Http

@{
    var session = Context.Session;
    var impersonatedCompanyId = session?.GetString("ImpersonatedCompanyId");
    var impersonatedCompanyName = session?.GetString("ImpersonatedCompanyName") ?? "Not selected";
    var hasCompanyContext = !string.IsNullOrEmpty(impersonatedCompanyId);
    var pickerCollapseClass = hasCompanyContext ? "collapse" : "collapse show";
}
