<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>POS Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#007bff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)" />

    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/styles/overlayscrollbars.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/adminlte.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/datatables/datatables.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/apexcharts@3.37.1/dist/apexcharts.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jsvectormap@1.5.3/dist/css/jsvectormap.min.css" crossorigin="anonymous" />

    @RenderSection("Head", required: false)

    <style>
        .company-search-results {
            position: absolute;
            left: 0;
            right: 0;
            z-index: 1050;
            max-height: 260px;
            overflow-y: auto;
        }
    </style>
</head>
<body class="layout-fixed sidebar-expand-lg sidebar-open bg-body-tertiary">
    <div class="app-wrapper">
        @await Component.InvokeAsync("TopBar")
        @await Component.InvokeAsync("Sidebar")

        <main role="main" class="pb-3">
            <section class="border-bottom bg-body-tertiary">
                <div class="container-fluid py-3">
                    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-3">
                        <div>
                            <div class="fw-semibold">
                                @(hasCompanyContext ? "Active company" : "Select a company to get started")
                            </div>
                            <div class="text-muted">
                                @(hasCompanyContext? impersonatedCompanyName : "Data will remain locked until a company is selected.")
                            </div>
                        </div>
                        <div class="ms-lg-auto">
                            <button class="btn btn-outline-primary"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#companyPickerPanel"
                                    aria-expanded="@(hasCompanyContext ? "false" : "true")"
                                    aria-controls="companyPickerPanel">
                                @(hasCompanyContext ? "Switch company" : "Choose company")
                            </button>
                            <a class="btn btn-link text-decoration-none" asp-page="/SuperAdmin/SwitchCompany">
                                Open picker page
                            </a>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-3">
                        <div>
                            <div class="fw-semibold text-uppercase text-muted small">Tenant context</div>
                            <div class="fs-5 fw-semibold mb-1">
                                @(hasCompanyContext ? impersonatedCompanyName : "No company selected")
                            </div>
                            <div class="text-muted small">
                                @(hasCompanyContext ? "Switch to another company at any time." : "Choose a company to unlock tenant-specific data.")
                            </div>
                        </div>
                        <div class="ms-lg-auto d-flex gap-2 flex-wrap">
                            <button class="btn btn-outline-primary"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#companyPickerPanel"
                                    aria-expanded="@(hasCompanyContext ? "false" : "true")"
                                    aria-controls="companyPickerPanel">
                                @(hasCompanyContext ? "Switch company" : "Choose company")
                            </button>
                            <a class="btn btn-link text-decoration-none" asp-page="/SuperAdmin/SwitchCompany">
                                Open full picker
                            </a>
                        </div>
                    </div>

                    <div class="@pickerCollapseClass mt-3" id="companyPickerPanel">
                        <form asp-page="/SuperAdmin/SwitchCompany"
                              method="post"
                              class="row g-3 align-items-end"
                              data-company-picker="true">
                            <div class="col-lg-5 position-relative">
                                <label for="layoutCompanySearch" class="form-label">Search company</label>
                                <input id="layoutCompanySearch"
                                       type="text"
                                       class="form-control form-control-lg"
                                       placeholder="Type at least 2 characters"
                                       autocomplete="off"
                                       data-company-search />
                                <div class="list-group shadow-sm mt-1 d-none company-search-results"
                                     data-company-results></div>
                            </div>

                            <input type="hidden" name="companyId" data-company-id />
                            <input type="hidden" name="companyName" data-company-name />

                            <div class="col-lg-3">
                                <label class="form-label">Current selection</label>
                                <div class="form-control-plaintext fw-semibold">
                                    @(hasCompanyContext? impersonatedCompanyName : "None")
                                </div>
                            </div>

                            <div class="col-lg-2 d-grid">
                                <button type="submit"
                                        class="btn btn-primary btn-lg"
                                        data-company-submit
                                        disabled>
                                    Use company
                                </button>
                            </div>

                            <div class="col-12">
                                <span class="text-danger small" data-company-error></span>
                            </div>
                        </form>
                    </div>
                </div>
            </section>

            @RenderBody()
        </main>
    </div>

    <partial name="_Footer" />

    <script src="https://code.jquery.com/jquery-3.7.0.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2/dist/umd/popper.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.min.js" crossorigin="anonymous"></script>
    <script src="~/js/adminlte.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/browser/overlayscrollbars.browser.es6.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.37.1/dist/apexcharts.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsvectormap@1.5.3/dist/js/jsvectormap.min.js" crossorigin="anonymous"></script>
    <script src="~/lib/datatables/datatables.min.js" asp-append-version="true"></script>
    <script src="~/js/company-picker.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>


