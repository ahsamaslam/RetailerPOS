@model Retailer.Web.Models.SuperAdminTopBarViewModel

<nav class="navbar navbar-top navbar-expand navbar-dark bg-default border-bottom py-3">
    <div class="container-fluid d-flex flex-column flex-lg-row align-items-stretch gap-3">

        <!-- Company context + actions -->
        <div class="d-flex flex-column flex-lg-row flex-grow-1 gap-3">
            <div class="text-white">
                <div class="fw-semibold text-uppercase text-white-50 small mb-1">
                    Company context
                </div>
                <div class="fs-5">
                    @(Model.HasCompanyContext ? Model.CompanyName : "No company selected")
                </div>
                <div class="text-muted small">
                    @(Model.HasCompanyContext
                        ? "You can switch to another company at any time."
                        : "Data remains locked until a company is selected.")
                </div>
            </div>

            <div class="ms-lg-auto d-flex flex-wrap gap-2 align-items-center">
                <button class="btn btn-outline-light"
                        type="button"
                        data-toggle="collapse"         @* Bootstrap 4 *@
                        data-target="#companyPickerPanel"
                        aria-expanded="@(Model.HasCompanyContext ? "false" : "true")"
                        aria-controls="companyPickerPanel">
                    @(Model.HasCompanyContext ? "Switch company" : "Choose company")
                </button>
                <a class="btn btn-link text-decoration-none"
                   asp-page="/SuperAdmin/SwitchCompany">
                    Open picker page
                </a>
            </div>
        </div>

        <div class="d-flex align-items-center gap-3 flex-wrap">
            <partial name="~/Pages/Shared/Components/TopBar/_Search.cshtml"
                     model="Model.UserInfo" />
            <partial name="~/Pages/Shared/Components/TopBar/_CurrentUser.cshtml"
                     model="Model.UserInfo" />
        </div>
    </div>
</nav>
