@model Retailer.Web.Models.LayoutUserInfo
<!-- Topnav -->
<nav class="navbar navbar-top navbar-expand navbar-light bg-white border-bottom" id="topbar-main">
    <div class="container-fluid d-flex align-items-center gap-4 flex-wrap">
        <button class="navbar-toggler always-visible" type="button"
                data-sidebar-toggle
                data-target="#sidenav-main"
                aria-controls="sidenav-main"
                aria-expanded="true"
                aria-label="Toggle sidebar">
            <span class="navbar-toggler-icon"></span>
        </button>

        @if (Model?.IsSuperAdmin == true)
        {   
            <div class="d-flex flex-wrap align-items-center flex-grow-1 gap-4">
                <div class="current-company-block me-auto">
                    <small class="text-muted text-uppercase">Current company</small>
                    <span class="fw-semibold">@Model.CompanyDisplayName</span>
                </div>
                <div class="btn-group company-actions mx-auto" role="group" aria-label="Company actions">
                    <button type="button"
                            class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1"
                            data-bs-toggle="collapse"
                            data-bs-target="#companyPickerPanel"
                            aria-controls="companyPickerPanel"
                            aria-expanded="@(Model.HasCompanyContext ? "false" : "true")">
                        <i class="bi bi-arrow-repeat"></i>
                        @(Model.HasCompanyContext ? "Switch" : "Choose")
                    </button>
                    <a class="btn btn-sm btn-primary d-flex align-items-center gap-1"
                       asp-page="/SuperAdmin/SwitchCompany">
                        <i class="bi bi-columns-gap"></i>
                        Full picker
                    </a>
                </div>
            </div>
        }

        <div class="d-flex align-items-center gap-3 flex-wrap ms-auto">
            <partial name="~/Pages/Shared/Components/TopBar/_Search.cshtml" />
            <partial name="~/Pages/Shared/Components/TopBar/_CurrentUser.cshtml" />
        </div>
    </div>
</nav>
