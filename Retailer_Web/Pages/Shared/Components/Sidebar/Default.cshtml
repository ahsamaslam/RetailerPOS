@using Retailer.Web.ViewComponents
@using Retailer.Web.ApiDTOs
@model SidebarViewModel
@{
    var path = Context.Request.Path;

    bool isAdminSection = path.StartsWithSegments("/admin");
    bool isUsers = path.StartsWithSegments("/admin/user");
    bool isRoles = path.StartsWithSegments("/admin/roles");
    bool isPermissions = path.StartsWithSegments("/admin/permissions");
    bool isUploadData = path.StartsWithSegments("/admin/upload-data");

    string currentPath = path.Value?.TrimEnd('/') ?? "";

    bool IsActive(string? route)
    {
        if (string.IsNullOrWhiteSpace(route))
            return false;

        var normalized = "/" + route.Trim().Trim('/');
        var current = string.IsNullOrEmpty(currentPath) ? "/" : currentPath;

        return current.Equals(normalized, StringComparison.OrdinalIgnoreCase)
            || current.StartsWith(normalized + "/", StringComparison.OrdinalIgnoreCase);
    }

    string ResolveUrl(string? route)
    {
        if (string.IsNullOrWhiteSpace(route))
            return "#";

        var trimmed = route.Trim();

        if (trimmed.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            return trimmed;

        string? TryResolvePage(string candidate)
        {
            if (string.IsNullOrWhiteSpace(candidate))
                return null;

            var pageUrl = Url.Page(candidate);
            return string.IsNullOrEmpty(pageUrl) ? null : pageUrl;
        }

        if (trimmed.StartsWith("/"))
        {
            return TryResolvePage(trimmed) ?? trimmed;
        }

        var normalized = $"/{trimmed.TrimStart('/')}";
        return TryResolvePage(normalized) ?? normalized;
    }
}
<!-- Sidenav -->
<nav class="sidebar-panel flex-shrink-0 p-3 bg-white" id="sidenav-main">
    <a class="d-flex align-items-center pb-3 mb-3 link-dark text-decoration-none border-bottom" href="/">
        <img src="~/img/brand/blue.png" alt="Brand" class="me-2" style="max-height:32px">
        <span class="fs-5 fw-semibold">Control Panel</span>
    </a>

    <ul class="list-unstyled ps-0" data-sidebar-accordion="true">
        <li class="mb-1">
            <a class="btn btn-nav align-items-center rounded @(Context.Request.Path == "/" ? "active" : string.Empty)"
               href="@ResolveUrl("/")">
                <i class="ni ni-tv-2 text-yellow me-2"></i>
                <span>Dashboard</span>
            </a>
        </li>
        @if (Model.User?.IsSuperAdmin == true)
        {
            <li class="mb-1">
                <a class="btn btn-nav align-items-center rounded @(Context.Request.Path == "/companies" ? "active" : string.Empty)"
                   href="@ResolveUrl("/companies")">
                    <i class="ni ni-tv-2 text-yellow me-2"></i>
                    <span>Companies</span>
                </a>
            </li>            
        }
        @if (Model.Menus.Any() && (Model.User?.IsAdmin == true || Model.User?.IsSuperAdmin == true))
        {
            <li class="mb-1">
                <a class="btn btn-nav align-items-center rounded @(Context.Request.Path == "/branches" ? "active" : string.Empty)"
                   href="@ResolveUrl("/branches")">
                    <i class="fa fa-code-branch text-yellow me-2"></i>
                    <span>Branches</span>
                </a>
            </li>
        }
        @foreach (var menu in Model.Menus
                            .Where(m => m.IsActive 
                            && !(m.SubMenus?.FirstOrDefault()?.UrlTitle?.Contains("report") 
                            ?? false))
                            .OrderBy(m => m.SortOrder))
        {
            var icon = string.IsNullOrWhiteSpace(menu.Icon)
                ? "fa fa-circle"
                : menu.Icon;

            var rawSubMenus = menu.SubMenus ?? new List<SubMenuDto>();
            var subMenus = rawSubMenus
                .Where(sm => sm.IsActive)
                .OrderBy(sm => sm.SortOrder)
                .ToList();

            var hasChildren = subMenus.Any();
            var defaultRoute = menu?.UrlTitle;
            var sectionKey = $"menu-section-{menu.Id}";
            var menuIsActive = hasChildren
                ? subMenus.Any(sm => IsActive(sm.UrlTitle))
                : IsActive(defaultRoute);

            if (hasChildren)
            {
                <li class="mb-1 sidebar-section @(menuIsActive ? "menu-open" : string.Empty)">
                    <button type="button"
                            class="btn btn-toggle align-items-center rounded @(menuIsActive ? string.Empty : "collapsed")"
                            data-sidebar-section-trigger="@sectionKey"
                            aria-expanded="@(menuIsActive.ToString().ToLower())">
                        <i class="nav-icon @icon text-yellow me-2"></i>
                        <span>@menu.Title</span>
                    </button>
                    <div class="collapse @(menuIsActive ? "show" : string.Empty)"
                         id="@sectionKey"
                         data-sidebar-section="@sectionKey">
                        <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
                            @foreach (var sub in subMenus)
                            {
                                <li>
                                    <a class="link-dark rounded @(IsActive(sub.UrlTitle) ? "active" : string.Empty)"
                                       href="@ResolveUrl(sub.UrlTitle)">
                                        @sub.Title
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </li>
            }
            else
            {
                <li class="mb-1">
                    <a class="btn btn-nav align-items-center rounded @(menuIsActive ? "active" : string.Empty)"
                       href="@ResolveUrl(defaultRoute)">
                        <i class="nav-icon @icon text-yellow me-2"></i>
                        <span>@menu.Title</span>
                    </a>
                </li>
            }
        }

        @if (Model.Menus.Any() && (Model.User?.IsAdmin == true || Model.User?.IsSuperAdmin == true))
        {
            <li class="border-top my-3"></li>
            <li class="mb-1 sidebar-section @(isAdminSection ? "menu-open" : string.Empty)">
                <button type="button"
                        class="btn btn-toggle align-items-center rounded @(isAdminSection ? string.Empty : "collapsed")"
                        data-sidebar-section-trigger="admin-panel"
                        aria-expanded="@(isAdminSection.ToString().ToLower())">
                    <i class="nav-icon fa fa-tools text-yellow me-2"></i>
                    <span>Admin Panel</span>
                </button>
                <div class="collapse @(isAdminSection ? "show" : string.Empty)"
                     id="admin-panel"
                     data-sidebar-section="admin-panel">
                    <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
                        <li>
                            <a class="link-dark rounded @(isUsers ? "active" : string.Empty)" href="/admin/user">Users</a>
                        </li>
                        <li>
                            <a class="link-dark rounded @(isRoles ? "active" : string.Empty)" href="/admin/roles">Roles</a>
                        </li>
                        <li>
                            <a class="link-dark rounded @(isPermissions ? "active" : string.Empty)" href="/admin/permissions">Permissions</a>
                        </li>
                        <li>
                            <a class="link-dark rounded @(isUploadData ? "active" : string.Empty)" href="/admin/upload-data">Upload Data</a>
                        </li>
                        <li>
                            <a class="link-dark rounded @(isUploadData ? "active" : string.Empty)" href="/SaleInvoiceSettings">Sale Invoice Setting</a>
                        </li>
                    </ul>
                </div>
            </li>
        }
    </ul>
</nav>