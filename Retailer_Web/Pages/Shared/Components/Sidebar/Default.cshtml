@using Retailer.Web.ViewComponents
@model SidebarViewModel
@{
    var path = Context.Request.Path;

    bool isAdminSection = path.StartsWithSegments("/admin");
    bool isUsers = path.StartsWithSegments("/admin/user");
    bool isRoles = path.StartsWithSegments("/admin/roles");
    bool isPermissions = path.StartsWithSegments("/admin/permissions");

    string currentPath = path.Value?.TrimEnd('/') ?? "";

    bool IsActive(string? route)
    {
        if (string.IsNullOrWhiteSpace(route))
            return false;

        var r = route.TrimEnd('/');

        return currentPath.Equals(r, StringComparison.OrdinalIgnoreCase)
            || currentPath.StartsWith(r + "/", StringComparison.OrdinalIgnoreCase);
    }

    string ResolveUrl(string? route)
    {
        if (string.IsNullOrWhiteSpace(route))
            return "#";

        if (route.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            return route;

        if (route.StartsWith("/"))
            return route;

        return Url.Page(route) ?? "#";
    }
}
<!-- Sidenav -->
<nav class="sidenav navbar navbar-vertical fixed-left navbar-expand-xs navbar-light bg-white" id="sidenav-main">
    <div class="scrollbar-inner">

        <!-- Brand -->
        <div class="sidenav-header  align-items-center">
            <a class="navbar-brand" href="/Index">
                <img src="~/img/brand/blue.png" class="navbar-brand-img" alt="..." style="max-height:10rem; margin-top:-50px">
            </a>
        </div>
        <div class="navbar-inner">
            <!-- Collapse -->
            <div class="collapse navbar-collapse" id="sidenav-collapse-main">

                <!-- Collapse header -->
                <div class="navbar-collapse-header d-md-none">
                    <div class="row">
                        <div class="col-6 collapse-brand">
                            <a href="/">
                                <img src="~/img/brand/blue.png">
                            </a>
                        </div>
                        <div class="col-6 collapse-close">
                            <button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#sidenav-collapse-main" aria-controls="sidenav-main" aria-expanded="false" aria-label="Toggle sidenav">
                                <span></span>
                                <span></span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Navigation -->
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Path == "/" ? "active" : "")" href="@ResolveUrl("/")">
                            <i class="ni ni-tv-2 text-yellow"></i> Dashboard
                        </a>
                    </li>
                    @foreach (var menu in Model.Menus
                                        .Where(m => m.IsActive)
                                        .OrderBy(m => m.SortOrder))
                    {
                        var icon = string.IsNullOrWhiteSpace(menu.Icon)
                        ? "bi bi-circle-fill"
                        : menu.Icon;

                        var firstRoute = menu.SubMenus?.FirstOrDefault()?.Route;

                        <li class="nav-item">
                            <a class="nav-link @(IsActive(firstRoute) ? "active" : "")"
                               href="@ResolveUrl(firstRoute)">
                                <i class="@icon text-yellow"></i>@menu.Title
                            </a>
                        </li>
                    }
                    @if (Model.Menus.Count() > 0 && (Model.User?.IsAdmin == true || Model.User?.IsSuperAdmin == true))
                    {
                        <li class="nav-item @(isAdminSection ? "menu-open" : "")">
                            <a href="#"
                               class="nav-link @(isAdminSection ? "active" : "")"
                               aria-expanded="@(isAdminSection.ToString().ToLower())">
                                <i class="nav-icon fa fa-tools text-yellow"></i>
                                Admin Panel
                            </a>

                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="/admin/user"
                                       class="nav-link @(isUsers ? "active" : "")">
                                        <i class="nav-icon fa fa-user text-yellow"></i>Users
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/admin/roles"
                                       class="nav-link @(isRoles ? "active" : "")">
                                        <i class="nav-icon fa fa-user-check text-yellow"></i>Roles
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/admin/permissions"
                                       class="nav-link @(isPermissions ? "active" : "")">
                                        <i class="nav-icon fa fa-user-alt-slash text-yellow"></i>Permissions
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</nav>
