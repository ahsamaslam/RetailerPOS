<!DOCTYPE html>
<html>
<head>
    <partial name="_PageHeadElement"/>
    
    @RenderSection("Styles", required: false)
    @RenderSection("HeadScripts", required: false)
</head>
<body class="bg-default">

    @{
        var hasIdentityHeader = IsSectionDefined("IdentityHeader");
    }

    <div class="main-content d-flex flex-column min-vh-100">
        <partial name="Auth/_Navbar"/>
       
        @if (hasIdentityHeader)
        {
            <section class="identity-shell flex-fill d-flex flex-column flex-lg-row">
                <div class="identity-hero position-relative d-flex flex-column">
                    @RenderSection("IdentityHeader", false)
                </div>
                <div class="identity-content d-flex align-items-center justify-content-center">
                    @RenderBody()
                </div>
            </section>
        }
        else
        {
            <div class="container-fluid mt-4 pt-4 flex-fill">
                @RenderBody()
            </div>
        }

        <partial name="_Footer"/>
    </div>

    <partial name="_ThemeScripts"/>

    @RenderSection("Scripts", required: false)
</body>
</html>
