<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RetailerMobileApp.Features.Dashboard.ViewModels"
             x:Class="RetailerMobileApp.Features.Dashboard.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="{Binding Title}">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F8FAFF" Offset="0" />
            <GradientStop Color="#EEF2FF" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24"
                                  Spacing="24"
                                  Margin="0,0,0,32">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Welcome back," FontSize="16" TextColor="#64748B" />
                        <Label Text="{Binding UserDisplayName}"
                               FontSize="30"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />
                        <Label Text="{Binding UserRole}" FontSize="14" TextColor="#94A3B8" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            WidthRequest="64"
                            HeightRequest="64"
                            BackgroundColor="#E0E7FF"
                            StrokeThickness="0"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="32" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleProfileMenuCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding UserInitials}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#4C1D95" />
                    </Border>
                </Grid>

                <Border Padding="20"
                        StrokeThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4C1D95" Offset="0" />
                            <GradientStop Color="#7C3AED" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#33000000" Offset="0,12" Radius="28" Opacity="0.45" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="20">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Good to see you," FontSize="14" TextColor="#E0E7FF" />
                            <Label Text="{Binding UserDisplayName}"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="{Binding UserRole}" FontSize="14" TextColor="#C4B5FD" />
                            <Label Text="Your shortcuts are ready whenever you are."
                                   FontSize="13"
                                   TextColor="#E0E7FF" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                WidthRequest="76"
                                HeightRequest="76"
                                StrokeThickness="0"
                                BackgroundColor="#FFFFFF33"
                                HorizontalOptions="End"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="38" />
                            </Border.StrokeShape>
                            <Label Text="{Binding UserInitials}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </Border>
                    </Grid>
                </Border>

                <Label Text="Quick actions"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#111827" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding PrimaryActions}"
                                      Spacing="18">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DashboardShortcut">
                            <Border Padding="20"
                                    BackgroundColor="White"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#16000000" Offset="0,8" Radius="18" Opacity="0.4" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenShortcutCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="12">
                                    <Border BackgroundColor="{Binding AccentColor}"
                                            HeightRequest="6"
                                            WidthRequest="70"
                                            HorizontalOptions="Start"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="3" />
                                        </Border.StrokeShape>
                                    </Border>

                                    <Label Text="{Binding Title}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A" />
                                    <Label Text="{Binding Description}"
                                           FontSize="14"
                                           TextColor="#6B7280"
                                           LineBreakMode="WordWrap" />
                                    <Grid ColumnDefinitions="*,Auto"
                                          VerticalOptions="Center">
                                        <Label Text="{Binding Title}"
                                               FontAttributes="Bold"
                                               TextColor="#111827" />
                                        <Label Grid.Column="1"
                                               Text="→"
                                               FontSize="22"
                                               FontAttributes="Bold"
                                               TextColor="{Binding AccentColor}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <BoxView Color="#80000000"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill"
                 IsVisible="{Binding IsProfileMenuVisible}"
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding HideProfileMenuCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border BackgroundColor="White"
                Padding="16"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0,120,24,0"
                IsVisible="{Binding IsProfileMenuVisible}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#33000000" Offset="0,8" Radius="20" Opacity="0.5" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="12">
                <Button Text="Profile settings"
                        Command="{Binding OpenProfileCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#111827"
                        HorizontalOptions="Fill"
                        ContentLayout="Left,10"
                        Padding="0" />
                <BoxView HeightRequest="1" Color="#E5E7EB" />
                <Button Text="Logout"
                        Command="{Binding LogoutCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#DC2626"
                        HorizontalOptions="Fill"
                        ContentLayout="Left,10"
                        Padding="0" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>

