<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RetailerMobileApp.Features.Reports.ViewModels"
             x:Class="RetailerMobileApp.Features.Reports.Views.ReportsLandingPage"
             x:DataType="vm:ReportsLandingViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Title}" FontSize="28" FontAttributes="Bold" TextColor="#111827" />
                <Label Text="Choose a report to analyze performance."
                       FontSize="14"
                       TextColor="#6B7280" />
            </VerticalStackLayout>

            <CollectionView ItemsSource="{Binding Reports}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16"
                                Margin="0,0,0,12"
                                BackgroundColor="#EEF2FF"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label Text="{Binding .}" FontSize="16" TextColor="#312E81" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
