<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RetailerMobileApp.Features.Purchases.ViewModels"
             x:Class="RetailerMobileApp.Features.Purchases.Views.PurchasesLandingPage"
             x:DataType="vm:PurchasesLandingViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Title}" FontSize="28" FontAttributes="Bold" TextColor="#111827" />
                <Label Text="Track purchase orders and deliveries."
                       FontSize="14"
                       TextColor="#6B7280" />
            </VerticalStackLayout>

            <Button Text="Create purchase order"
                    Command="{Binding CreatePurchaseCommand}"
                    HeightRequest="48"
                    BackgroundColor="#059669"
                    TextColor="White"
                    CornerRadius="12" />

            <Label Text="Pending purchases" FontSize="18" FontAttributes="Bold" TextColor="#111827" />

            <CollectionView ItemsSource="{Binding PendingPurchases}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16"
                                Margin="0,0,0,12"
                                BackgroundColor="#ECFDF5"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label Text="{Binding .}" FontSize="16" TextColor="#065F46" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
